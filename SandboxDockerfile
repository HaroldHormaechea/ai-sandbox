# UC-27 — single glibc (Debian) base for EVERY session.
#
# Pre-UC-27 the base forked by build flavour: a lean Alpine/musl base for normal
# sessions and a glibc/Debian base only when "Android testing" was baked in. That
# fork existed because the Android emulator's QEMU binary can't load under gcompat
# on musl (missing `posix_fallocate64`). UC-27 makes toolchains opt-in capabilities
# provisioned EAGERLY AT SPAWN rather than baked into the image, so the emulator
# now needs glibc on every session that might enable Android — and the simplest,
# least-surprising answer is a single glibc base for all sessions. No more apk/apt
# fork, no `ANDROID_BASE`/`ANDROID_TESTING` build args, no build-time SDK bake.
#
# A no-capability session is behaviourally equivalent to the old Alpine session:
# same tools (Node + Claude Code + git/tmux/gh/ssh + ripgrep + gitleaks + rtk),
# same non-root `claude` user at uid/gid 1000, same arbitrary-uid (group-0) recipe.
ARG BASE_IMAGE=node:20-bookworm-slim
FROM ${BASE_IMAGE}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# UC-17 — pin HOME so the container resolves a home dir even when it runs as an
# arbitrary host uid that has no /etc/passwd entry at start. entrypoint.sh
# self-registers a passwd line on boot; this ENV is the value the shell/tools
# read before (and if) that runs. For the default `claude` user (uid 1000) this
# is exactly the home it already had — no behaviour change.
ENV HOME=/home/claude

ARG GITLEAKS_VERSION=8.21.0
# BuildKit auto-populates TARGETARCH (amd64 / arm64 / ...). Used below to pick
# the right RTK release tarball.
ARG TARGETARCH

# ── Base userland — Node + Claude Code + git/tmux/gh/ssh + ripgrep + gitleaks +
#    the non-root `claude` user. glibc/Debian only now (no apk fork).
RUN set -eu; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    # GitHub CLI is NOT in Debian's default repos (the Alpine base got it from the
    # `github-cli` apk package). Add the official GitHub CLI apt repo so `gh` is
    # present on the universal glibc base — required to keep the no-capability
    # session behaviourally identical to the old Alpine one (UC-27 AC#11).
    mkdir -p -m 755 /etc/apt/keyrings; \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends \
      git ripgrep bash tmux gh openssh-client unzip \
      uidmap slirp4netns fuse-overlayfs dbus-user-session iproute2; \
    # UC-27 — rootless-Docker prerequisites for the `dind` capability. The
    # Alpine base provided these via apk (shadow-uidmap / slirp4netns /
    # fuse-overlayfs); the glibc/Debian flip must install the apt equivalents or
    # `dockerd-rootless.sh` dies with `newuidmap: executable file not found`:
    #   uidmap            → newuidmap / newgidmap (the immediate blocker: sub-uid
    #                       /sub-gid mapping for the rootless userns)
    #   slirp4netns       → rootless networking (else it falls back to the absent
    #                       vpnkit and networking fails)
    #   fuse-overlayfs    → rootless storage driver (avoids the slow vfs fallback)
    #   dbus-user-session → recommended for the rootless/systemd-user session
    #   iproute2          → `ip` — required by slirp4netns / rootlesskit to set up
    #                       the rootless network namespace
    # Dormant unless the `dind` capability is enabled; harmless otherwise.
    # node:*-bookworm-slim ships Node + npm preinstalled; only install via apt
    # when the base did not (defensive — keeps a plain debian base working).
    if ! command -v node >/dev/null 2>&1; then \
      apt-get install -y --no-install-recommends nodejs npm; \
    fi; \
    rm -rf /var/lib/apt/lists/*; \
    # Pin `claude` to uid/gid 1000. The node:*-bookworm base ships a `node` user
    # already holding uid/gid 1000, which would otherwise push claude to 1001 —
    # and then a dev-mode session cannot write its bind mounts (./workspace and
    # ./claude-config are created by spawn.sh as the operator's uid, almost always
    # 1000), so the entrypoint dies with "Permission denied" creating ~/.claude.
    # Free 1000 (the `node` user/group is unused by ai-sandbox — only the node
    # binary matters) and pin claude to it. The UC-17 group-0 recipe below still
    # covers the server-spawned <uid>:0 case.
    if getent passwd node >/dev/null 2>&1; then userdel node; fi; \
    if getent group node >/dev/null 2>&1; then groupdel node 2>/dev/null || true; fi; \
    useradd -u 1000 -m -d /home/claude -s /bin/bash claude; \
    npm install -g @anthropic-ai/claude-code; \
    curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/').tar.gz" \
       | tar -xz -C /usr/local/bin gitleaks; \
    chmod +x /usr/local/bin/gitleaks; \
    ssh-keyscan github.com >> /etc/ssh/ssh_known_hosts; \
    mkdir -p /workspace /home/claude/.claude/skills; \
    chown -R claude:claude /workspace /home/claude; \
    # UC-17 — OpenShift arbitrary-uid recipe. Make $HOME and /workspace owned by
    # group 0 and group-writable (g=u mirrors the owner bits) so a container run
    # as <host-uid>:0 can create ~/.ssh, ~/.claude/*, ~/.config/rtk, etc. For the
    # default uid-1000 `claude` user nothing changes functionally.
    chgrp -R 0 /home/claude /workspace; \
    chmod -R g=u /home/claude /workspace; \
    # Let an unknown runtime uid append its own passwd entry on boot (see
    # entrypoint.sh). Group-0 owns /etc/passwd and may write it. Standard pattern
    # for OpenShift-style arbitrary-uid images; harmless for uid 1000.
    chgrp 0 /etc/passwd; \
    chmod g+w /etc/passwd

# RTK (Rust Token Killer) — bundled CLI proxy that compresses Bash output before
# it reaches the LLM. Rolling latest at build time (matches the
# @anthropic-ai/claude-code pinning policy, NOT the pinned gitleaks pattern).
# On amd64 the upstream musl build is statically linked, so it runs unchanged on
# the glibc base; on arm64 the gnu build runs natively on glibc (no gcompat shim
# needed now that the base is always glibc). Source: https://github.com/rtk-ai/rtk
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) RTK_TARBALL="rtk-x86_64-unknown-linux-musl.tar.gz" ;; \
      arm64) RTK_TARBALL="rtk-aarch64-unknown-linux-gnu.tar.gz" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/rtk-ai/rtk/releases/latest/download/${RTK_TARBALL}" \
       | tar -xz -C /usr/local/bin rtk; \
    chmod +x /usr/local/bin/rtk; \
    echo "Installed RTK version: $(/usr/local/bin/rtk --version)"

# System-wide git hooks (currently: pre-commit secret scan via gitleaks).
COPY git-hooks/ /etc/git-hooks/
RUN chmod +x /etc/git-hooks/* \
    && git config --system core.hooksPath /etc/git-hooks

# ── UC-27 — capability provisioning assets (no build-time toolchain bake) ────
# Capabilities (DinD / Java / Android) are provisioned EAGERLY AT SPAWN by
# entrypoint.sh, which sources the manifests under /opt/ai-sandbox/devtools.d/
# and runs each enabled capability's devtool_provision hook. Both trees are
# shipped UNCONDITIONALLY and stay dormant unless AI_SANDBOX_DEVTOOLS lists a
# capability — a no-capability session never touches them.
#
# The Android emulator runbook skill ships here too; entrypoint.sh seeds it into
# ~/.claude/skills ONLY when the `android` capability is enabled for the session
# (a build-time copy into ~/.claude can't work — that dir is bind-mounted at
# runtime and would mask it). gid-0 = uid perms so an arbitrary-uid runtime user
# can still read both trees.
COPY container-bin/skills/ /opt/ai-sandbox/skills/
COPY devtools.d/ /opt/ai-sandbox/devtools.d/
RUN chgrp -R 0 /opt/ai-sandbox && chmod -R g=u /opt/ai-sandbox

# In-container capability helpers. Always shipped; each is dormant unless its
# capability is provisioned at spawn.
#   aisandbox-dind     — rootless Docker daemon (UC-26 semantics unchanged).
#   aisandbox-java     — Temurin JDK provisioner + JAVA_HOME/PATH wiring (UC-27).
#   aisandbox-android  — Android SDK provisioner + ANDROID_HOME/PATH wiring (UC-27).
#   aisandbox-emulator — headless AVD provisioning/boot (reworked in UC-27 to
#                        use the spawn-provisioned SDK root, no baked SDK).
COPY container-bin/aisandbox-emulator /usr/local/bin/aisandbox-emulator
COPY container-bin/aisandbox-java /usr/local/bin/aisandbox-java
COPY container-bin/aisandbox-android /usr/local/bin/aisandbox-android
COPY container-bin/aisandbox-dind /usr/local/bin/aisandbox-dind
RUN chmod +x /usr/local/bin/aisandbox-emulator \
             /usr/local/bin/aisandbox-java \
             /usr/local/bin/aisandbox-android \
             /usr/local/bin/aisandbox-dind

COPY --chown=claude:claude entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER claude
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
