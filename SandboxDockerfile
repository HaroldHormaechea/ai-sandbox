FROM alpine:latest

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# UC-17 — pin HOME so the container resolves a home dir even when it runs as
# an arbitrary host uid that has no /etc/passwd entry at start. entrypoint.sh
# self-registers a passwd line on boot; this ENV is the belt-and-braces value
# the shell/tools read before (and if) that runs. For the default `claude`
# user (uid 1000) this is exactly the home it already had — no behaviour change.
ENV HOME=/home/claude

ARG GITLEAKS_VERSION=8.21.0
# BuildKit auto-populates TARGETARCH (amd64 / arm64 / ...). Used below to pick
# the right RTK release tarball and to decide whether gcompat is needed.
ARG TARGETARCH

RUN apk add --no-cache nodejs npm git ripgrep bash ca-certificates tmux github-cli openssh-client curl \
    && npm install -g @anthropic-ai/claude-code \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/').tar.gz" \
       | tar -xz -C /usr/local/bin gitleaks \
    && chmod +x /usr/local/bin/gitleaks \
    && ssh-keyscan github.com >> /etc/ssh/ssh_known_hosts \
    && adduser -D -h /home/claude claude \
    && mkdir -p /workspace /home/claude/.claude/skills \
    && chown -R claude:claude /workspace /home/claude \
    # UC-17 — OpenShift arbitrary-uid recipe. Make $HOME and /workspace owned by
    # group 0 and group-writable (g=u mirrors the owner bits) so a container run
    # as <host-uid>:0 can create ~/.ssh, ~/.claude/*, ~/.config/rtk, etc. For the
    # default uid-1000 `claude` user nothing changes functionally: it already
    # owns these paths, and adding group-0 write access is a no-op for it.
    && chgrp -R 0 /home/claude /workspace \
    && chmod -R g=u /home/claude /workspace \
    # Let an unknown runtime uid append its own passwd entry on boot (see
    # entrypoint.sh). Group-0 owns /etc/passwd and may write it. Standard pattern
    # for OpenShift-style arbitrary-uid images; harmless for uid 1000.
    && chgrp 0 /etc/passwd \
    && chmod g+w /etc/passwd

# RTK (Rust Token Killer) — bundled CLI proxy that compresses Bash output before
# it reaches the LLM. Rolling latest at build time (matches the
# @anthropic-ai/claude-code pinning policy, NOT the pinned gitleaks pattern).
# Upstream ships a musl binary for amd64 and a glibc binary for aarch64, so on
# arm64 we also install gcompat as a glibc shim. Source: https://github.com/rtk-ai/rtk
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) \
        RTK_TARBALL="rtk-x86_64-unknown-linux-musl.tar.gz" ;; \
      arm64) \
        apk add --no-cache gcompat; \
        RTK_TARBALL="rtk-aarch64-unknown-linux-gnu.tar.gz" ;; \
      *) \
        echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/rtk-ai/rtk/releases/latest/download/${RTK_TARBALL}" \
       | tar -xz -C /usr/local/bin rtk; \
    chmod +x /usr/local/bin/rtk; \
    echo "Installed RTK version: $(/usr/local/bin/rtk --version)"

# System-wide git hooks (currently: pre-commit secret scan via gitleaks).
COPY git-hooks/ /etc/git-hooks/
RUN chmod +x /etc/git-hooks/* \
    && git config --system core.hooksPath /etc/git-hooks

# ── UC22 — optional Android build/test/emulator toolchain ────────────────────
# Baked only when the operator selects "Android testing" in setup.sh, which
# passes ANDROID_TESTING=1 as a build arg (docker-compose.yml build.args).
# amd64-only — x86_64 system images won't run on arm64 (arm64 is a documented
# UC22 follow-up, AC15). The glibc-linked SDK binaries (aapt2/adb/emulator) need
# a glibc shim on Alpine/musl: gcompat + libc6-compat — the same approach the
# RTK block above already uses on arm64.
#
#   ⚠ EMPIRICALLY UNVERIFIED at authoring time (no Docker/KVM in the authoring
#     environment). gcompat sufficiency for aapt2 / the QEMU emulator is the key
#     open risk. If a required binary still won't load under gcompat on a real
#     host, switch this image to a glibc base (Debian/Ubuntu) per
#     use-cases/22-onboarding-toolchain-android-testing.md → "gcompat→glibc
#     fallback" / "Testing Limitations".
#
# Baked (so the lint/test/assemble/bundle lane works offline, AC7/AC8): JDK 21 +
# cmdline-tools + platform-tools + platforms;android-36 + build-tools;36.0.0
# (matches android-ci.yml + gradle/libs.versions.toml — AC14). NOT baked
# (provisioned lazily on first emulator use by `aisandbox-emulator`, into the
# persisted /workspace/environment-utilities — AC9): the ~1.5 GB x86_64 system
# image, the emulator package, and the AVD.
ARG ANDROID_TESTING=0
ARG ANDROID_CMDLINE_TOOLS_VERSION=11076708
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}"
RUN set -eu; \
    if [ "${ANDROID_TESTING}" = "1" ]; then \
      if [ "${TARGETARCH}" != "amd64" ]; then \
        echo "ERROR: Android testing toolchain is amd64-only (TARGETARCH=${TARGETARCH}); arm64 is a documented follow-up (UC22 AC15)." >&2; \
        exit 1; \
      fi; \
      apk add --no-cache gcompat libc6-compat openjdk21-jdk unzip; \
      mkdir -p "${ANDROID_HOME}/cmdline-tools"; \
      curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS_VERSION}_latest.zip" -o /tmp/cmdline-tools.zip; \
      unzip -q /tmp/cmdline-tools.zip -d "${ANDROID_HOME}/cmdline-tools"; \
      mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest"; \
      rm -f /tmp/cmdline-tools.zip; \
      yes | "${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" --licenses >/dev/null; \
      "${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager" \
        "platform-tools" "platforms;android-36" "build-tools;36.0.0" >/dev/null; \
      chgrp -R 0 "${ANDROID_HOME}" && chmod -R g=u "${ANDROID_HOME}"; \
      echo "Android toolchain baked OK ($(java -version 2>&1 | head -1))"; \
    fi
# Stamp the toolchain state onto the image so spawn.sh can decide /dev/kvm
# passthrough at run time (and so server-spawned sessions inherit it). "1" when
# baked, "0" otherwise.
LABEL com.ai-sandbox.toolchain.android="${ANDROID_TESTING}"

# In-container emulator helper (UC22 AC10) — invoked by the in-sandbox Claude
# Code session to lazily provision + boot a headless AVD for
# :android:connectedAndroidTest. Always shipped; it self-checks and prints clear
# guidance if the Android toolchain was not baked into this image.
COPY container-bin/aisandbox-emulator /usr/local/bin/aisandbox-emulator
RUN chmod +x /usr/local/bin/aisandbox-emulator

COPY --chown=claude:claude entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER claude
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
