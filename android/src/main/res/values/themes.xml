<?xml version="1.0" encoding="utf-8"?>
<!--
  Bootstrap theme used by the Activity before Compose paints anything.
  Dark-only (UC04 AC13). Compose's AiSandboxTheme owns the live M3
  Expressive color scheme; this XML theme exists only so the system
  status bar + nav bar are correct from cold start.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AiSandbox" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/bootstrap_surface</item>
        <item name="android:navigationBarColor">@color/bootstrap_surface</item>
        <item name="android:windowBackground">@color/bootstrap_workbench</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
