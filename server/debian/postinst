#!/bin/sh
# ai-sandbox-server / postinst — Debian package post-install hook (UC07).
#
# Idempotent. Runs after dpkg has unpacked the new files. The work here is
# strictly preparatory:
#
#   1. systemd daemon-reload (the unit file under /lib/systemd/system/ may
#      have been replaced).
#   2. Create the ai-sandbox-server system user if it does not exist. The
#      argv MUST match `SystemUserAdmin.Default#USERADD_ARGV_PREFIX` in
#      `server/src/main/java/com/aisandbox/server/cli/SystemUserAdmin.java`
#      — drift would cause `dpkg install` and `aisandboxctl pki init` to
#      produce different uid/shell/group setups, breaking the install-flow
#      idempotency promise documented in server/README.md.
#   3. Pre-create the operator-managed directory tree with the documented
#      modes and ownership, so `aisandboxctl pki init` finds a sensible
#      baseline and reports "no conflicts" on a clean install. The actual
#      PKI material + config.yaml are intentionally NOT created here —
#      operator runs `pki init` afterwards. Same for `secrets seed`.
#
# Print a "Next steps" block at the end so the operator never has to dig
# through README.md to discover the post-install workflow.
#
# Exit 0 always. Any failure to chmod / chown / mkdir is reported to
# stderr but does NOT abort the install — `pki init` will resurface the
# specific problem with a clearer error message at the right phase.
set -e

case "$1" in
    configure)
        # Capture the upgrade indicator NOW, before the onboarding block reuses
        # the positional params ($@) to build the onboard argv. On `configure`,
        # $2 is the most-recently-configured version (empty on a fresh install,
        # the old version on an upgrade). The UC-19 Next-steps logic needs it.
        IS_UPGRADE=0
        if [ -n "$2" ]; then
            IS_UPGRADE=1
        fi

        # UC-94 — snapshot whether this host was ALREADY provisioned, BEFORE
        # block 3 below pre-creates the state-root tree. The bundled repair/
        # ensure helpers (block 3c) MUST be no-ops on a fresh install:
        #   • ensure-host-subid.sh does `install -d <secrets-dir>/dind`, which
        #     would CREATE /etc/ai-sandbox-server/secrets — but that dir is
        #     `pki init`/`onboard`/`secrets seed`'s to create, and a
        #     pre-existing secrets dir makes `pki init` refuse ("conflict:
        #     /etc/ai-sandbox-server/secrets"). Postinst must NOT create it.
        #   • repair-state-root.sh has nothing to repair on a first install (no
        #     per-session bind-source debris yet).
        # So each helper runs ONLY when its target already exists — i.e. an
        # upgrade/reinstall over an already-provisioned host (the UC-94 self-heal
        # scenario, incl. reinstall-over-purge, where /var/lib is not dpkg-tracked
        # and the debris survives). The state-root check must be captured HERE
        # because block 3 (`install -d … /var/lib/ai-sandbox-server/sessions`)
        # creates that dir unconditionally; the secrets dir is never created by
        # postinst, so a plain existence test is a faithful "already provisioned"
        # signal for it. On a fresh install, `aisandboxctl onboard` / `secrets
        # seed` provision the dind subid files later via DindStateStep (unchanged).
        SECRETS_DIR_PREEXISTS=0
        if [ -d /etc/ai-sandbox-server/secrets ]; then
            SECRETS_DIR_PREEXISTS=1
        fi
        STATE_ROOT_PREEXISTS=0
        if [ -d /var/lib/ai-sandbox-server/sessions ]; then
            STATE_ROOT_PREEXISTS=1
        fi

        # 1. systemd daemon reload.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi

        # 2. System user. The flags MUST match
        # SystemUserAdmin.Default.USERADD_ARGV_PREFIX exactly — see
        # the Javadoc on that field for the cross-reference protocol.
        if ! getent passwd ai-sandbox-server >/dev/null 2>&1; then
            useradd \
                --system \
                --no-create-home \
                --shell /usr/sbin/nologin \
                --user-group \
                --groups docker \
                ai-sandbox-server
        fi

        # 3. Operator-managed directory tree. Mode + ownership match
        # what `aisandboxctl pki init` would set; running pki init
        # afterwards is therefore idempotent on these directories.
        # PKI material, allowlist, secrets, enrollment, and
        # config.yaml are NOT created — those are pki init's job.
        install -d -m 0750 -o ai-sandbox-server -g ai-sandbox-server /etc/ai-sandbox-server
        install -d -m 0750 -o ai-sandbox-server -g ai-sandbox-server /var/lib/ai-sandbox-server
        # UC-15 — docker config root for the service. The systemd unit sets
        # DOCKER_CONFIG=/var/lib/ai-sandbox-server/docker-config so docker
        # never reaches into the user's locked-down $HOME (ProtectHome=true).
        # Mode 0700 because docker writes credentials in config.json. We do
        # NOT pre-create config.json itself — docker writes it on first
        # invocation. Idempotent on re-installs (install -d is a no-op when
        # the directory already exists at the requested mode/owner).
        install -d -m 0700 -o ai-sandbox-server -g ai-sandbox-server /var/lib/ai-sandbox-server/docker-config
        # UC-63 — host-state sessions root. The UC-62 server host-shell
        # ("SERVER SSH SESSION") puts its tmux socket at
        # /var/lib/ai-sandbox-server/sessions/server-ssh.sock. On a fresh
        # install this subdir was otherwise created lazily by spawn.sh only on
        # the first Docker session, so opening the SSH row first on a freshly
        # installed server hit a missing parent dir. Pre-create it here with the
        # same mode/ownership as the sibling state dirs so it exists before
        # first use regardless of whether a Docker session was ever spawned.
        # Idempotent and ownership-agreeing with spawn.sh's lazy create.
        install -d -m 0750 -o ai-sandbox-server -g ai-sandbox-server /var/lib/ai-sandbox-server/sessions
        # UC-64 — host-shell HOME. The UC-62 server host-shell runs tmux + a
        # login shell whose $HOME would otherwise be the ProtectHome-hidden
        # /home/ai-sandbox-server, so tmux/the shell hit EACCES reading their
        # config. The service redirects HOME to this accessible, writable dir
        # under the host-state tree (the unit's ReadWritePaths), mirroring how
        # DOCKER_CONFIG redirects Docker. Mode 0700 / ai-sandbox-server owner,
        # matching docker-config and the runtime ensureCreated() pre-create.
        # Idempotent on re-installs.
        install -d -m 0700 -o ai-sandbox-server -g ai-sandbox-server /var/lib/ai-sandbox-server/sessions/server-ssh-home
        install -d -m 0750 -o ai-sandbox-server -g ai-sandbox-server /var/log/ai-sandbox-server
        # UC-84 — the self-update trigger dir. The (non-root) server drops its
        # bare, payload-free marker here; the root ai-sandbox-updater.path watch
        # fires the updater. Owned by ai-sandbox-server 0750 so the service can
        # write the marker (it sits under the unit's
        # ReadWritePaths=/var/lib/ai-sandbox-server) but cannot touch the root
        # updater unit/script. The path literal MUST match
        # UpdateTriggerService.TRIGGER_DIR and the .path unit (CI cross-checks).
        # Purge cleanup is already covered by `rm -rf /var/lib/ai-sandbox-server`
        # in postrm. Idempotent on re-installs.
        install -d -m 0750 -o ai-sandbox-server -g ai-sandbox-server /var/lib/ai-sandbox-server/update-trigger

        # 3c. UC-94 — repair stale root-owned per-session bind-source debris and
        #     provision the server-owned DinD subuid/subgid delegation files. The
        #     Docker daemon auto-creates any missing per-session bind source
        #     root:root; because /var/lib is not dpkg-tracked, that debris
        #     survives `apt purge` + reinstall, so re-running the repair on a
        #     reinstall over that surviving state is what makes the install
        #     self-heal (guarded on pre-existence — see below). Both helpers are
        #     the SINGLE implementation shared with `aisandboxctl onboard` /
        #     `secrets seed` (anti-drift) and ship NON-EXECUTABLE in the deb, so
        #     they MUST be invoked via `bash <path>` (a `test -x` would also be
        #     wrong — see server-ci.yml's presence check). Guarded + idempotent;
        #     `|| true` keeps postinst's `exit 0` contract even on failure.
        #     FRESH-INSTALL GUARD (UC-94 CI regression fix): each helper runs
        #     only when its target ALREADY existed before this install (see the
        #     PREEXISTS snapshot above). On a fresh install both are skipped, so
        #     postinst never pre-creates /etc/ai-sandbox-server/secrets and the
        #     subsequent `aisandboxctl pki init` (which owns that dir) does not
        #     hit a spurious "refusing to overwrite" conflict. The `[ -f … ]`
        #     presence tests stay as the inner guard so the invocation lines
        #     remain present (DebPostinstContractTest asserts them verbatim).
        AISB_DIND_DIR=/opt/ai-sandbox-server/host/devtools.d/dind
        if [ "$STATE_ROOT_PREEXISTS" = "1" ]; then
            if [ -f "$AISB_DIND_DIR/repair-state-root.sh" ]; then
                bash "$AISB_DIND_DIR/repair-state-root.sh" \
                    --state-root /var/lib/ai-sandbox-server/sessions \
                    --owner ai-sandbox-server:ai-sandbox-server || true
            fi
        fi
        if [ "$SECRETS_DIR_PREEXISTS" = "1" ]; then
            if [ -f "$AISB_DIND_DIR/ensure-host-subid.sh" ]; then
                bash "$AISB_DIND_DIR/ensure-host-subid.sh" \
                    --secrets-dir /etc/ai-sandbox-server/secrets \
                    --owner ai-sandbox-server:ai-sandbox-server || true
            fi
        fi

        # 3a. UC-84 — enable the self-update trigger watch. Guarded + container-
        # tolerant (no systemd in chroots/containers → `|| true`). Enabled after
        # the trigger dir exists so the DirectoryNotEmpty watch arms cleanly.
        # `enable --now` starts the .path watch immediately and on every boot.
        # NOTE: the updater.service is intentionally NOT enabled (it is path-
        # activated only).
        #
        # We also arm boot-time autostart of the server itself so it comes up on
        # every reboot without a manual `systemctl start` — previously the
        # operator had to enable it by hand, so a fresh boot left the management
        # server down until someone ran systemctl. We use plain `enable` here,
        # NOT `enable --now`: a fresh, not-yet-onboarded install has no PKI
        # material, so starting it immediately would only crash-latch the unit
        # `failed` (StartLimitBurst). `enable` just installs the
        # multi-user.target wants-symlink (the unit ships `WantedBy=
        # multi-user.target`), so systemd starts the service automatically on the
        # next boot, once onboarding + `aisandboxctl client mint` have
        # provisioned it. Idempotent and guarded the same way as the path watch.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl enable --now ai-sandbox-updater.path >/dev/null 2>&1 || true
            systemctl enable ai-sandbox-server.service >/dev/null 2>&1 || true
        fi

        # 3b. UC-38 — versioned session-image rebuild on upgrade. On an UPGRADE
        #     (IS_UPGRADE=1) with Docker available, refresh ai-context:latest
        #     when its labelled version differs from the version this package
        #     bundles. aisandboxctl reads its OWN (newly unpacked) version from
        #     the jar manifest, so nothing is templated here. Runs BEFORE the
        #     onboarding block so the later lazy build sees a current image and
        #     skips (no double build). Fully guarded (AC8): the rebuild itself
        #     always exits 0, and a `timeout`-bounded wrap + the `if`-guard keep
        #     a hung/slow build from ever failing or wedging dpkg/apt. The
        #     multi-minute blocking on a real rebuild is accepted (UC-38). A
        #     fresh install (IS_UPGRADE=0) is untouched — no eager build, AC9.
        if [ "$IS_UPGRADE" = "1" ] && command -v docker >/dev/null 2>&1; then
            echo "ai-sandbox-server: checking the session image for staleness (upgrade)..."
            if timeout 1800 /usr/bin/aisandboxctl onboard --rebuild-image-if-stale </dev/null; then
                :
            else
                echo "ai-sandbox-server: session-image rebuild timed out or could not start;" >&2
                echo "  rebuild later with: sudo aisandboxctl onboard --rebuild-image" >&2
            fi
        fi

        # 4. UC-17 / UC-19 — onboarding. The `config` script gathered the
        #    answers (or, under the noninteractive frontend, left the template
        #    defaults). We read them, then immediately db_stop so the rest of
        #    postinst writes to the real terminal rather than the debconf
        #    protocol pipe on fd 1. UC-19 then picks one of three paths:
        #
        #      1. Controlling terminal present (works under `dpkg -i` AND
        #         `apt install`) — offer a [Y/n] invite and, on yes, run the
        #         FULL interactive wizard (Claude device-flow login + image
        #         build) on /dev/tty, prefilled with any debconf answers.
        #      2. No terminal but debconf preseeded — the UC-17 non-interactive
        #         onboard (--no-claude-preinit --no-image-build); Claude OAuth
        #         needs a TTY and the image build is slow + Docker-bound.
        #      3. No terminal, no preseed — defer with one clear next-step.
        #
        #    The package install never fails or hangs because of onboarding:
        #    the tty probe is set -e-safe and every onboard call is guarded.
        ONBOARD_DONE=0
        ONBOARD_INTERACTIVE=0
        ONBOARD=""
        GIT_NAME=""
        GIT_EMAIL=""
        SSH_KEY_PATH=""
        GH_TOKEN=""
        if [ -r /usr/share/debconf/confmodule ]; then
            . /usr/share/debconf/confmodule
            # `if db_get …` keeps set -e happy: db_get returns non-zero when a
            # question was never registered (e.g. raw `dpkg -i` without the
            # frontend running `config`), in which case the var stays empty.
            if db_get ai-sandbox-server/onboard;       then ONBOARD="$RET"; fi
            if db_get ai-sandbox-server/git-name;      then GIT_NAME="$RET"; fi
            if db_get ai-sandbox-server/git-email;     then GIT_EMAIL="$RET"; fi
            if db_get ai-sandbox-server/ssh-key-path;  then SSH_KEY_PATH="$RET"; fi
            if db_get ai-sandbox-server/gh-token;      then GH_TOKEN="$RET"; fi
            # Never persist the token in the debconf database.
            db_set ai-sandbox-server/gh-token "" || true
            db_stop || true
        fi

        # Idempotency gate (UC-19 B3 / AC7). A non-empty captured .claude.json
        # proves a previous onboarding ran the (post-UC-19) Claude pre-init
        # capture — pre-UC-19 builds never captured it, so any non-empty one
        # here is necessarily post-fix. When present we skip the interactive
        # invite to avoid a spurious re-prompt; fresh installs and stale/old
        # templates (missing or empty .claude.json) are still offered.
        CLAUDE_TEMPLATE_JSON=/etc/ai-sandbox-server/templates/claude-config/.claude.json
        CLAUDE_SNAPSHOT_PRESENT=0
        if [ -s "$CLAUDE_TEMPLATE_JSON" ]; then
            CLAUDE_SNAPSHOT_PRESENT=1
        fi

        # Controlling-terminal probe (UC-19 C1). We must detect /dev/tty WITHOUT
        # aborting the script when it is absent. NOTE: the obvious form
        # `if { exec 3<>/dev/tty; } 2>/dev/null` is NOT safe — on dash a
        # redirection failure on `exec` exits the (non-interactive) shell even
        # inside the `if`/group/redirect guard, which would fail the install on
        # no-tty systems. A subshell + a regular builtin contains the failure to
        # the subshell, so the parent only sees a non-zero status. /dev/tty
        # resolves to the operator's terminal under both `dpkg -i` (fds usually
        # preserved) and `apt install` (maintainer-script stdio is piped into
        # apt's progress UI, but the controlling terminal is still /dev/tty).
        HAVE_TTY=0
        if ( true <>/dev/tty ) 2>/dev/null; then
            HAVE_TTY=1
        fi
        # Defense-in-depth (Debian Policy 3.9.1 — maintainer scripts must not
        # prompt under a noninteractive frontend). When DEBIAN_FRONTEND is
        # noninteractive, force HAVE_TTY=0 so the [Y/n] invite is skipped
        # entirely: CI and unattended installs never even reach the bounded
        # read below (no 30s wait), layered on top of its timeout guard.
        if [ "${DEBIAN_FRONTEND:-}" = "noninteractive" ]; then
            HAVE_TTY=0
        fi

        # gh token → 0600 temp file (used by whichever branch onboards) so the
        # token never appears in the process table. Shredded after onboard runs.
        GH_TOKEN_FILE=""
        if [ -n "$GH_TOKEN" ]; then
            GH_TOKEN_FILE="$(mktemp)"
            chmod 600 "$GH_TOKEN_FILE"
            printf '%s' "$GH_TOKEN" > "$GH_TOKEN_FILE"
        fi

        if [ "$CLAUDE_SNAPSHOT_PRESENT" = "0" ] && [ "$HAVE_TTY" = "1" ] && [ "$ONBOARD" != "false" ]; then
            # ── Branch 1 — interactive invite on the controlling terminal ──
            # NOT gated on ONBOARD=true: a raw `dpkg -i` never runs the config
            # script, so there are no answers to gate on — the terminal itself
            # is the signal. We DO respect an explicit debconf opt-out
            # (ONBOARD=false) so the operator is never re-prompted after saying
            # no. The probe above proved /dev/tty is openable, so this `exec`
            # cannot fail (and thus cannot abort the script); we open fd 3 RW.
            exec 3<>/dev/tty
            printf '\n' >&3
            printf 'ai-sandbox-server: run the onboarding wizard now (Claude login + image build)? [Y/n] ' >&3
            # Bounded, dash-portable read on the controlling terminal. A real
            # operator answers within 30s; an automated / non-interactive
            # install where input never arrives (or fd 3 hits EOF) MUST DEFER
            # rather than block. An unbounded read here ran to GitHub Actions'
            # 360-min job ceiling and produced the ~6h CI hang. The inner read
            # runs inside a `timeout`-wrapped child shell so a stuck read can
            # never wedge dpkg. Behaviour contract (verified on /usr/bin/dash):
            #   blocking input -> timeout (exit 124)   -> defer
            #   EOF            -> read non-zero (1)     -> defer
            #   typed `y`      -> exit 0, REPLY="y"     -> proceed
            #   bare Enter     -> exit 0, REPLY=""      -> proceed
            REPLY=""
            if REPLY="$(timeout 30 sh -c 'IFS= read -r r; ec=$?; printf %s "$r"; exit $ec' <&3 2>/dev/null)"; then
                case "$REPLY" in
                    [Nn]*)
                        : # declined — fall through to the deferred Next-steps block.
                        ;;
                    *)
                        # Prefill the onboard argv from any debconf answers (each
                        # optional) via positional params — no eval, no word-split
                        # of operator-supplied values. `set --` first drops $1
                        # ("configure"); IS_UPGRADE was already captured above.
                        set --
                        if [ -n "$GIT_NAME" ]; then set -- "$@" --git-name "$GIT_NAME"; fi
                        if [ -n "$GIT_EMAIL" ]; then set -- "$@" --git-email "$GIT_EMAIL"; fi
                        if [ -n "$SSH_KEY_PATH" ]; then set -- "$@" --git-key "$SSH_KEY_PATH"; fi
                        if [ -n "$GH_TOKEN_FILE" ]; then set -- "$@" --gh-token-file "$GH_TOKEN_FILE"; fi
                        echo "ai-sandbox-server: launching interactive onboarding (Ctrl-C to abort)..." >&3
                        # Wire stdin+stdout+stderr to the terminal: onboard's TTY
                        # gate is System.console(), non-null only when BOTH stdin and
                        # stdout are terminals. WITHOUT --no-claude-preinit /
                        # --no-image-build so the full device-flow + image build run.
                        if /usr/bin/aisandboxctl onboard "$@" <&3 >&3 2>&3; then
                            ONBOARD_DONE=1
                            ONBOARD_INTERACTIVE=1
                        else
                            echo "ai-sandbox-server: onboarding did not complete; re-run later with: sudo aisandboxctl onboard" >&3
                        fi
                        ;;
                esac
            else
                # Bounded read returned non-zero: timeout (rc 124, input never
                # arrived) or EOF (rc 1, fd 3 closed). DEFER — do NOT fall
                # through to onboard.
                echo "ai-sandbox-server: no response — deferring onboarding (run: sudo aisandboxctl onboard)" >&3 || true
            fi
            exec 3>&- || true
        elif [ "$ONBOARD" = "true" ] && [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
            # ── Branch 2 — no terminal but debconf preseeded (UC-17) ──
            # Fully non-interactive: Claude OAuth needs a TTY and the image
            # build is slow + Docker-bound, so both are skipped here. Build the
            # argv via positional params; $1 ("configure") is not referenced
            # again and IS_UPGRADE was captured above.
            set -- --git-name "$GIT_NAME" --git-email "$GIT_EMAIL"
            if [ -n "$SSH_KEY_PATH" ]; then
                set -- "$@" --git-key "$SSH_KEY_PATH"
            fi
            if [ -n "$GH_TOKEN_FILE" ]; then
                set -- "$@" --gh-token-file "$GH_TOKEN_FILE"
            else
                set -- "$@" --no-gh
            fi
            set -- "$@" --no-claude-preinit --no-image-build

            echo "ai-sandbox-server: running onboarding wizard (non-interactive)..."
            if /usr/bin/aisandboxctl onboard "$@" </dev/null; then
                ONBOARD_DONE=1
            else
                echo "ai-sandbox-server: onboarding step failed; complete it later with: sudo aisandboxctl onboard" >&2
            fi
        fi
        # Branch 3 (no terminal, no preseed) needs no action here — it falls
        # through to the deferred Next-steps block below.

        # Shred the gh-token temp file regardless of which branch ran.
        if [ -n "$GH_TOKEN_FILE" ] && [ -f "$GH_TOKEN_FILE" ]; then
            if command -v shred >/dev/null 2>&1; then
                shred -u "$GH_TOKEN_FILE" 2>/dev/null || rm -f "$GH_TOKEN_FILE"
            else
                rm -f "$GH_TOKEN_FILE"
            fi
        fi

        # 5. Next steps. Four shapes: onboarded-interactively, onboarded-
        #    non-interactively, upgrade-with-a-stale-Claude-template (B3), and
        #    the full deferred block (fresh install, no tty / declined / no
        #    preseed). Exactly one is printed (AC4 — one unambiguous next step).
        if [ "$ONBOARD_DONE" = "1" ] && [ "$ONBOARD_INTERACTIVE" = "1" ]; then
            cat <<'EOM'

ai-sandbox-server installed and onboarded interactively (Claude pre-init
captured; session image built). Remaining steps:

  1. sudo aisandboxctl client mint <name> --pem --out /tmp/<name>
       Authorize at least one client. The server starts fine on an empty
       allowlist but refuses every request (401) until a client cert is
       present; mint one here, or enroll a device with
       `aisandboxctl client invite <name>`. Both hot-reload — no restart.

  2. sudo systemctl start ai-sandbox-server   # boot-autostart is already enabled by install

Re-run `sudo aisandboxctl onboard --force` any time to refresh credentials or
re-capture the Claude pre-init snapshot. The CLI wrapper is at /usr/bin/aisandboxctl.

Re-run `sudo aisandboxctl reconfigure` to revisit development-tool selections
(Docker-in-Docker, etc.) — changes apply to NEW sessions only.

EOM
        elif [ "$ONBOARD_DONE" = "1" ]; then
            cat <<'EOM'

ai-sandbox-server installed and onboarded. Remaining steps:

  1. sudo aisandboxctl client mint <name> --pem --out /tmp/<name>
       Authorize at least one client. The server starts fine on an empty
       allowlist but refuses every request (401) until a client cert is
       present; mint one here, or enroll a device with
       `aisandboxctl client invite <name>`. Both hot-reload — no restart.

  2. sudo systemctl start ai-sandbox-server   # boot-autostart is already enabled by install

Claude pre-init was NOT captured (it needs a terminal). From a terminal, run
`sudo aisandboxctl onboard` to capture it so spawned sessions skip Claude's
first-run wizard — or `sudo aisandboxctl onboard --claude-config-source <dir>`
for an unattended seed. Re-run any time to refresh credentials.

Re-run `sudo aisandboxctl reconfigure` to revisit development-tool selections
(Docker-in-Docker, etc.) — changes apply to NEW sessions only.

EOM
        elif [ "$IS_UPGRADE" = "1" ] && [ "$CLAUDE_SNAPSHOT_PRESENT" = "0" ]; then
            cat <<'EOM'

ai-sandbox-server upgraded. The Claude pre-init capture changed in this
release and your installed template predates it, so spawned sessions may
still hit Claude's first-run wizard. Refresh it from a terminal:

  sudo aisandboxctl onboard --force

(or `sudo aisandboxctl onboard --force --claude-config-source <dir>` for an
unattended seed). The CLI wrapper is at /usr/bin/aisandboxctl.

The session image is rebuilt automatically on upgrade when it is out of date.
If that rebuild was deferred (Docker down at install time), refresh it with:

  sudo aisandboxctl onboard --rebuild-image

EOM
        elif [ "$CLAUDE_SNAPSHOT_PRESENT" = "1" ]; then
            cat <<'EOM'

ai-sandbox-server installed; already onboarded (a Claude pre-init snapshot is
present) — nothing to do. Re-run `sudo aisandboxctl onboard --force` to refresh
credentials or re-capture the snapshot. If you haven't already:

  1. sudo aisandboxctl client mint <name> --pem --out /tmp/<name>
       Authorize at least one client; the server returns 401 to every request
       until one is present. Hot-reloads — no restart.

  2. sudo systemctl start ai-sandbox-server   # boot-autostart is already enabled by install

EOM
        else
            cat <<'EOM'

ai-sandbox-server installed. Onboarding was deferred. Next steps:

  1. sudo aisandboxctl onboard
       One-shot wizard: provisions the server cert + directory tree (PKI),
       captures the SSH key, git identity, an optional gh token, and — from a
       terminal — an interactive Claude pre-init snapshot (device-flow login).
       For unattended/headless installs, pass --claude-config-source <dir>
       with a pre-built ~/.claude/ tree instead. Gathers only what is missing;
       re-run with --force to refresh. Pass --hostname <fqdn> / --san for a
       custom cert SAN, --no-gh / --no-claude-preinit to opt out. The granular
       commands still work: `aisandboxctl pki init` then `aisandboxctl secrets seed`.

  2. sudo aisandboxctl client mint <name> --pem --out /tmp/<name>
       Authorize at least one client. The server starts fine on an empty
       allowlist but refuses every request (401) until a client cert is
       present; mint one here, or enroll a device with
       `aisandboxctl client invite <name>`. Both hot-reload — no restart.

  3. sudo systemctl start ai-sandbox-server   # boot-autostart is already enabled by install

The CLI wrapper is at /usr/bin/aisandboxctl (a thin POSIX shell shim
around the bundled aisandboxctl jar — `aisandboxctl --help` for usage).

Re-run `sudo aisandboxctl reconfigure` to revisit development-tool selections
(Docker-in-Docker, etc.) — changes apply to NEW sessions only.

EOM
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        : # dpkg-internal failure paths — nothing to do.
        ;;

    *)
        echo "postinst called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0
