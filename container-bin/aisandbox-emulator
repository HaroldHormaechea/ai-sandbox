#!/usr/bin/env bash
# aisandbox-emulator — manage a headless Android emulator inside an ai-sandbox
# session (UC-27; supersedes the UC-22 baked-SDK design).
#
# The session container IS a Claude Code session, so this is the command the
# in-container agent invokes to bring up an AVD for
# `./gradlew :android:connectedAndroidTest`.
#
# UC-27 change: the Android SDK is no longer baked into the image. The `android`
# capability is provisioned EAGERLY AT SPAWN by `aisandbox-android` into ONE
# self-consistent, persisted SDK root at /workspace/environment-utilities/android/
# sdk (cmdline-tools + platform-tools + build-tools + platform + x86_64
# system-image + emulator). That removes the old baked-SDK vs. lazy-bits split
# and the unified-root copy/symlink reconciliation it required — everything the
# emulator and avdmanager need already lives under ONE real root. This helper now
# just creates the AVD and boots it.
set -euo pipefail

VERSIONS_SH="${AISB_DEVTOOLS_VERSIONS:-/opt/ai-sandbox/devtools.d/lib/versions.sh}"
# shellcheck disable=SC1090
[ -r "$VERSIONS_SH" ] && . "$VERSIONS_SH" || true

CACHE_ROOT="${AISB_ANDROID_CACHE:-/workspace/environment-utilities/android}"
SDK_ROOT="$CACHE_ROOT/sdk"                  # the provisioned, persisted SDK root
AVD_HOME="$CACHE_ROOT/avd"                  # persisted AVDs
export ANDROID_AVD_HOME="$AVD_HOME"
export ANDROID_SDK_ROOT="$SDK_ROOT"
export ANDROID_HOME="$SDK_ROOT"
AVD_NAME="${AISB_AVD_NAME:-aisandbox}"
SYS_IMAGE="${AISB_SYS_IMAGE:-${AISB_ANDROID_SYSTEM_IMAGE:-system-images;android-36;google_apis;x86_64}}"
DEVICE_PROFILE="${AISB_AVD_DEVICE:-pixel_6}"
JAVA_ENV="${AISB_JAVA_CACHE:-/workspace/environment-utilities/java}/env.sh"

SDKMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/sdkmanager"
AVDMANAGER="$SDK_ROOT/cmdline-tools/latest/bin/avdmanager"
ADB="$SDK_ROOT/platform-tools/adb"
PIDFILE="$CACHE_ROOT/emulator.pid"
LOGFILE="$CACHE_ROOT/emulator.log"

log() { printf '  [aisandbox-emulator] %s\n' "$*" >&2; }
die() { printf '  [aisandbox-emulator] ERROR: %s\n' "$*" >&2; exit 1; }

# avdmanager needs a JDK; source the JDK env the `java` capability provisioned.
ensure_java() {
    # shellcheck disable=SC1090
    [ -r "$JAVA_ENV" ] && . "$JAVA_ENV" || true
}

require_toolchain() {
    [ -x "$SDKMANAGER" ] || die "Android SDK not provisioned at $SDK_ROOT. Enable the 'android' devtool (./setup.sh --reconfigure) and respawn — it provisions the SDK eagerly at spawn."
    ensure_java
}

kvm_ok() { [ -e /dev/kvm ] && [ -r /dev/kvm ] && [ -w /dev/kvm ]; }

# The emulator package + system image are normally already installed by
# aisandbox-android at spawn. Provision them on demand as a fallback (e.g. an
# older cache predating the emulator install) so `start` is self-healing.
ensure_emulator_installed() {
    if [ ! -x "$SDK_ROOT/emulator/emulator" ] || [ ! -d "$SDK_ROOT/system-images" ]; then
        log "Emulator / system image missing from $SDK_ROOT — installing (one-time, needs network)..."
        yes | "$SDKMANAGER" --sdk_root="$SDK_ROOT" --licenses >/dev/null 2>&1 || true
        "$SDKMANAGER" --sdk_root="$SDK_ROOT" "emulator" "$SYS_IMAGE" || die "Failed to install emulator + $SYS_IMAGE."
    fi
}

ensure_avd() {
    mkdir -p "$AVD_HOME"
    if ! ANDROID_SDK_ROOT="$SDK_ROOT" "$AVDMANAGER" list avd 2>/dev/null | grep -q "Name: $AVD_NAME"; then
        log "Creating AVD '$AVD_NAME' from '$SYS_IMAGE'..."
        echo "no" | ANDROID_SDK_ROOT="$SDK_ROOT" "$AVDMANAGER" create avd \
            -n "$AVD_NAME" -k "$SYS_IMAGE" --device "$DEVICE_PROFILE" --force
    fi
}

cmd_status() {
    if [ "$("$ADB" get-state 2>/dev/null || true)" = "device" ]; then
        log "Emulator running (adb state: device)."
        return 0
    fi
    log "No running emulator."
    return 1
}

cmd_start() {
    require_toolchain
    local accel_args=()
    if kvm_ok; then
        log "/dev/kvm present and accessible — hardware acceleration enabled."
    else
        log "WARNING: /dev/kvm not accessible. Without KVM the emulator falls back to software (TCG) emulation: extremely slow, often will not finish booting."
        log "  • Re-spawn on a host with KVM — spawn.sh auto-passes --device /dev/kvm when the android capability is enabled and /dev/kvm exists."
        log "  • The build + JVM-test lane (:android:lint/:test/:assembleDebug/:bundleDebug) does NOT need KVM and is unaffected."
        if [ "${1:-}" != "--no-accel" ]; then
            die "Refusing to start without KVM. Re-run with --no-accel to attempt (very slow) software emulation anyway."
        fi
        log "Proceeding with -no-accel (software emulation) as requested."
        accel_args+=(-no-accel)
    fi

    ensure_emulator_installed
    ensure_avd

    if cmd_status >/dev/null 2>&1; then
        log "Emulator already running — nothing to do."
        return 0
    fi

    log "Booting headless AVD '$AVD_NAME'..."
    ANDROID_SDK_ROOT="$SDK_ROOT" ANDROID_AVD_HOME="$AVD_HOME" \
        nohup "$SDK_ROOT/emulator/emulator" -avd "$AVD_NAME" \
        -no-window -gpu swiftshader_indirect -no-audio -no-boot-anim -no-snapshot \
        ${accel_args[@]+"${accel_args[@]}"} >"$LOGFILE" 2>&1 &
    echo "$!" > "$PIDFILE"

    log "Waiting for device + sys.boot_completed (can take several minutes on first boot)..."
    "$ADB" wait-for-device
    local tries=0
    until [ "$("$ADB" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
        tries=$((tries + 1))
        if [ "$tries" -gt 600 ]; then
            die "Emulator did not finish booting within ~20 min. See $LOGFILE"
        fi
        sleep 2
    done
    "$ADB" shell input keyevent 82 >/dev/null 2>&1 || true   # dismiss lock screen
    log "Emulator '$AVD_NAME' is booted and ready."
    log "Next: ./gradlew :android:connectedAndroidTest"
}

cmd_stop() {
    "$ADB" -e emu kill >/dev/null 2>&1 || true
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    log "Emulator stopped."
}

cmd_doctor() {
    require_toolchain
    log "SDK root           : $SDK_ROOT"
    log "java               : $(java -version 2>&1 | head -1 || echo 'MISSING')"
    log "adb                : $("$ADB" version 2>&1 | head -1 || echo 'MISSING / loader error')"
    log "/dev/kvm           : $(kvm_ok && echo 'present + accessible' || echo 'ABSENT/inaccessible — emulator will be slow/unavailable')"
    log "cache root         : $CACHE_ROOT"
    log "emulator installed : $([ -x "$SDK_ROOT/emulator/emulator" ] && echo yes || echo 'no (installed on first start)')"
    log "AVD '$AVD_NAME'      : $(ANDROID_SDK_ROOT="$SDK_ROOT" "$AVDMANAGER" list avd 2>/dev/null | grep -q "Name: $AVD_NAME" && echo present || echo 'not created yet')"
}

usage() {
    cat >&2 <<'EOF'
Usage: aisandbox-emulator <command> [--no-accel]

Commands:
  start    Create the AVD (and install the emulator + system image if a stale
           cache is missing them) and boot it headless; waits for
           sys.boot_completed. Requires /dev/kvm unless --no-accel is given.
  stop     Kill the running emulator.
  status   Report whether an emulator is attached (adb get-state).
  doctor   Print toolchain + KVM diagnostics.

Requires the `android` devtool to be enabled (provisions the SDK at spawn).
Then run the instrumented tests with:
  ./gradlew :android:connectedAndroidTest
EOF
}

case "${1:-}" in
    start)  shift; cmd_start "${1:-}" ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    -h|--help|"") usage; exit 2 ;;
    *) log "Unknown command: $1"; usage; exit 2 ;;
esac
