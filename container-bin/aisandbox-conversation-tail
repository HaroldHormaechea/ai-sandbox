#!/usr/bin/env node
/*
 * UC-37 — in-container transcript-tail helper (decision D2).
 *
 * Runs INSIDE a sandbox container (spawned by the host server via
 *   docker compose -p ai-sandbox-N exec -T claude-sandbox aisandbox-conversation-tail …)
 * and streams the live interactive `claude` session's structured output to the
 * server over stdout, which the server reads incrementally (TranscriptTailService).
 *
 * Why Node and not bash: the job is robust multi-file tailing with complete-line
 * integrity, restart re-baselining, and a changing subagent-file glob. The image
 * base is node:20-bookworm-slim, so `node` is always present; doing this in bash
 * would be fragile (partial-line reads, offset tracking). The tool reads only —
 * it never writes the transcript and never executes anything but read-only tmux
 * queries.
 *
 * OUTPUT ENVELOPE (helper → server), one line each:
 *   <source>\t<raw-transcript-json>      source = "main" | "subagent:<agentId>"
 *   __ctrl__\tbackfill-start\t<startIdx> begins the bounded backfill window; the
 *                                        primary reader carries its window start
 *                                        line index so the server can seed its
 *                                        UC-79 oldest-line (load-older) cursor
 *   __ctrl__\tbackfill-end               ends it; live append follows
 *   __ctrl__\tpage-meta\t<start>\t<at0>  (--fetch-page only) leads an older-page
 *                                        emission: <start> = oldest line index
 *                                        delivered (new cursor), <at0> = 1 at the
 *                                        transcript start
 *   __ctrl__\trebaseline                 the entrypoint restart loop spawned a
 *                                        fresh claude → new transcript file
 *   __ctrl__\tno-transcript              resolution yielded nothing after a
 *                                        bounded grace — fail LOUD instead of
 *                                        hanging silently (the original bug
 *                                        class: the channel stayed open while
 *                                        nothing ever arrived)
 * Only COMPLETE lines are emitted (a trailing partial line is buffered until its
 * newline arrives). A line is never parsed here — the server's
 * ConversationEventMapper owns that — so a malformed transcript line is passed
 * through verbatim and skipped server-side, never crashing the session (AC20).
 *
 * SCAN MODE (--scan-pending): one-shot. Resolve the active transcript, inspect
 * only its tail, print one of `pending-question` / `pending-activity` / `idle`,
 * exit 0. Used by the conversation enumerate path to badge non-selected targets
 * (AC18). Never blocks.
 *
 * ── Active-transcript resolution (the load-bearing part, RND §10) ──
 * The ORIGINAL implementation resolved the active transcript by scanning the
 * live claude PID's open fds for an open `*.jsonl`. That premise is empirically
 * FALSE on the shipping claude build: claude opens→appends→closes the transcript
 * per write (it watches via inotify) and holds ZERO `.jsonl` fds open between
 * writes. So fd-scanning returned null on essentially every poll and the helper
 * emitted nothing — no backfill, no transcript lines, no turn-end — while the
 * channel stayed open. That is the single root cause behind the three UC-37 bugs
 * (no user echo / no replies / spinner never clears).
 *
 * The fix resolves by **claude-process identity + cwd-slug**, never by a held fd:
 *   target tmux pane → #{pane_pid} → walk children to the `claude` descendant
 *     → /proc/<claudePid>/cwd  ⇒  cwd-slug  ⇒  ~/.claude/projects/<slug>/
 *     → /proc/<claudePid>/cmdline ⇒ identity (--agent-name/--team-name/--parent-session-id)
 *   • Teammate/subagent pane (cmdline has --agent-name): anchor to the top-level
 *     <slug>/<sid>.jsonl whose in-file (agentName, teamName) matches the cmdline
 *     tuple, newest mtime. (agentId is NOT used cross-surface — the cmdline form
 *     `analyst@team` never matches the transcript's hex stem.)
 *   • Main/orchestrator pane (cmdline has no --agent-name):
 *       0. sessionId-exact (preferred, current entrypoint): the restart loop now
 *          launches `claude --session-id <uuid>`, so the main pane's cmdline
 *          carries its OWN session id. Anchor main to <session-id>.jsonl EXACTLY.
 *          Until that file exists, resolution returns null (the helper surfaces a
 *          transient no-transcript state), so a freshly-started session can NEVER
 *          adopt a foreign session's transcript from the shared slug dir. This is
 *          the UC-37 session-bleed fix. UC-65 REFINEMENT: `/clear` makes claude
 *          ROTATE to a brand-new <new-uuid>.jsonl in the same slug while its
 *          cmdline --session-id (the LAUNCH id) is unchanged, so a pure exact
 *          anchor stays pinned to the stale pre-clear file forever. So once the
 *          launch file exists, if a STRICTLY-NEWER agentName-ABSENT transcript is
 *          present (claude rotated past its launch session) AND that transcript
 *          belongs to THIS pane's own lineage, adopt that newest file instead
 *          (selectMainCurrent). UC-91 CORRECTION: the mtime floor + agentName-absent
 *          filter alone are NOT foreign-safe — they only exclude STALE foreign
 *          sessions. A CONCURRENTLY-ACTIVE foreign session B' sharing the slug has an
 *          agentName-absent main transcript that is NEWER than this pane's idle launch
 *          file, so the pre-UC-91 rotation adopted it (the cross-session conversation
 *          bleed + wrong/empty agent pills on session→session switch). The lineage
 *          guard `isOwnLineage` (ownLineagePredicate → collectForeignMainSessionIds)
 *          enumerates every OTHER live claude main pane in the slug and refuses to
 *          adopt any transcript stem owned by a different session's --session-id, so
 *          ONLY this pane's own `/clear` rotation is ever followed. If the process
 *          table is unreadable the guard degrades to the exact `--session-id` anchor
 *          (never foreign adoption).
 *       1. Team active (no --session-id, old entrypoint): any teammate process in
 *          the same cwd-slug carries --parent-session-id = the orchestrator's
 *          transcript stem → anchor main to <parent-session-id>.jsonl exactly.
 *       2. No team (old-entrypoint fallback): the agentName-ABSENT <slug>/<sid>.jsonl
 *          with the newest mtime (the live session is the one being appended),
 *          re-anchored on a main-pane claude PID change (the restart loop).
 *     Tiers 1–2 are retained only for backward compatibility with a pre-fix
 *     entrypoint image whose claude launch carries no --session-id; with the
 *     current entrypoint, tier 0 always wins.
 * Once anchored, the file is followed STABLY — resolution re-runs when the pane's
 * claude PID changes (entrypoint restart) OR when a same-PID transcript ROTATION
 * is detected (UC-65: `/clear` starts a new session jsonl in-process; detectRotation
 * spots the newer agentName-absent / same-agent file and rebaselines so post-clear
 * turns stream again) — so the tail never hops onto a concurrent teammate or
 * foreign-session file. ~/.claude is bind-mounted/shared across sessions with the
 * same cwd-slug (AC23): identity-anchoring is mandatory; naive newest-mtime would
 * route a foreign session's conversation to the client, so rotation only ever
 * adopts a file within the pane's own identity family (agentName-absent for main,
 * matching (agentName, teamName) for a teammate) AND — for a main pane (UC-91) —
 * within the pane's own session lineage, never a stem owned by another live session.
 */

'use strict';

const fs = require('fs');
const path = require('path');
const os = require('os');
const { execFileSync } = require('child_process');

// ──────────────────────── args ────────────────────────

function parseArgs(argv) {
  const a = {
    session: 'main',
    window: null,
    pane: null,
    socket: null,
    backfill: 200,
    projectsDir: path.join(os.homedir() || '/home/claude', '.claude', 'projects'),
    scanPending: false,
    // UC-41 — one-shot detail fetch for a single tool call (AC5).
    fetchDetail: false,
    toolUseId: null,
    // UC-79 — one-shot "load older page" fetch (infinite scroll). Emits the
    // transcript slice [max(0, beforeLine - count), beforeLine) of the resolved
    // PRIMARY file, each line in the normal `<source>\t<raw-json>` envelope,
    // preceded by a `__ctrl__\tpage-meta\t<startIdx>\t<atStart(0|1)>` control line
    // so the server can advance its per-connection oldest-line cursor and stop at
    // the transcript start. Sibling of --fetch-detail (resolve once, read, exit).
    fetchPage: false,
    beforeLine: null,
    count: 100,
    // UC-47 — one-shot conversation-name derivation for the sessions-list row.
    conversationName: false,
    // UC-55 — one-shot read-only per-tab parse of the CURRENTLY-FOCUSED wizard tab
    // (the server steps the live pane and calls this once per tab to recover every
    // tab's options for a multi-question AskUserQuestion). Capture-only (no keystroke).
    parsePane: false,
    // UC-60 — one-shot enumeration of the lead's LIVE background subagents (each
    // <mainStem>/subagents/agent-<id>.jsonl whose mtime is within SUBAGENT_STALE_MS),
    // printed one JSON object per line ({id,label,working}). Feeds the conversation
    // enumerate path so each live subagent surfaces as a pill, with the same
    // working/idle parity team-agent pills carry.
    listSubagents: false,
    // UC-60 — streaming mode that tails ONLY one subagent's transcript
    // (<mainStem>/subagents/agent-<id>.jsonl), emitting `subagent:<id>\t<line>`. The
    // id is the BARE agent id (no `subagent:` prefix); the server passes it from the
    // pill's `subagent:<id>` target id. Tapping a subagent pill opens this stream so
    // its transcript is viewable, NEVER routed to the lead's pane.
    subagentId: null,
  };
  for (let i = 2; i < argv.length; i++) {
    const k = argv[i];
    switch (k) {
      case '--session': a.session = argv[++i]; break;
      case '--window': a.window = argv[++i]; break;
      case '--pane': a.pane = argv[++i]; break;
      case '--socket': a.socket = argv[++i]; break;
      case '--backfill': a.backfill = Math.max(1, parseInt(argv[++i], 10) || 200); break;
      case '--projects-dir': a.projectsDir = argv[++i]; break;
      case '--scan-pending': a.scanPending = true; break;
      case '--fetch-detail': a.fetchDetail = true; break;
      case '--tool-use-id': a.toolUseId = argv[++i]; break;
      case '--fetch-page': a.fetchPage = true; break;
      case '--before-line': a.beforeLine = Math.max(0, parseInt(argv[++i], 10) || 0); break;
      case '--count': a.count = Math.max(1, parseInt(argv[++i], 10) || 100); break;
      case '--conversation-name': a.conversationName = true; break;
      case '--parse-pane': a.parsePane = true; break;
      case '--list-subagents': a.listSubagents = true; break;
      case '--subagent': a.subagentId = argv[++i]; break;
      default: /* ignore unknown flag */ break;
    }
  }
  return a;
}

const ARGS = parseArgs(process.argv);

// Reserved control source + kinds (kept in lock-step with TranscriptTailService).
const CTRL_BACKFILL_START = 'backfill-start';
const CTRL_BACKFILL_END = 'backfill-end';
const CTRL_REBASELINE = 'rebaseline';
const CTRL_NO_TRANSCRIPT = 'no-transcript';
// UC-79 — leading control line of a --fetch-page emission. Carries TWO extra
// tab-delimited fields after the kind: the start line index of the slice actually
// delivered (the server's new oldest-line cursor) and atStart (1 when that start
// is the very beginning of the transcript, so no further paging is attempted):
// `__ctrl__\tpage-meta\t<startIdx>\t<atStart(0|1)>`.
const CTRL_PAGE_META = 'page-meta';
// UC-41 — emitted (instead of matched lines) when a --fetch-detail id is not found.
const CTRL_DETAIL_NOT_FOUND = 'detail-not-found';
// UC-50 — pane-signal pending-prompt control kinds (lock-step with
// TranscriptTailService.CTRL_PENDING_QUESTION / CTRL_PENDING_CLEAR). The
// pending-question line carries a THIRD tab-delimited field — the JSON prompt
// payload (`__ctrl__\tpending-question\t<json>`); pending-clear carries the
// last-emitted promptKey (`__ctrl__\tpending-clear\t<key>`).
const CTRL_PENDING_QUESTION = 'pending-question';
const CTRL_PENDING_CLEAR = 'pending-clear';

// UC-41 — total byte ceiling on a --fetch-detail emission. Matched lines are kept
// WHOLE (never truncated mid-JSON, so the server can always parse them); once the
// running total would exceed this cap, further matched lines are dropped. Set to
// the server's ProcessExecutor stdout buffer (64 KiB) so the server never has to
// truncate our output mid-line. The server additionally byte-bounds the RENDERED
// input/result to 48 KB (ConversationEventMapper.CONVERSATION_DETAIL_MAX_BYTES).
const DETAIL_OUTPUT_CAP_BYTES = 65536;

// How many bytes of a candidate transcript we read to sniff its (agentName,
// teamName) identity. The identifying lines are written at the very top of the
// file (observed at line index ~4), so a small head read is sufficient and cheap.
const ID_SCAN_BYTES = 131072;

// How many bytes we read from the END of a delegate transcript to derive its
// working/idle signal (UC-59). deriveWorking only inspects the last 60 lines, so a
// 128 KiB tail covers it comfortably while keeping the read O(1) regardless of how
// large a long-running delegate's transcript has grown.
const TAIL_SCAN_BYTES = 131072;

// UC-59 — bounded staleness window for a BACKGROUND SUBAGENT's transcript. Unlike a
// team agent (a separate `claude` OS process we can gate on pid-liveness), a
// background subagent runs IN-PROCESS under the lead, so there is no pid to anchor
// liveness on. Worse, a subagent transcript NEVER emits a {system,turn_duration}
// turn-end (verified live: its last line is always an `assistant` entry), so
// deriveWorking alone would report a finished subagent as "working" forever. The
// mtime window is therefore the PRIMARY completion + crash signal for subagents: an
// actively-working subagent appends to its transcript continuously, so once it
// finishes (or crashes) the file falls quiet and ages out of the window. Sized
// generously so an ordinary tool call between transcript writes is not mistaken for
// completion; the only cost of an over-long window is a cosmetically lingering
// spinner (benign — the lead's own turn-state covers the common resume-to-process
// case), whereas too short a window would flicker a busy subagent to idle.
//
// 300s is a deliberate balance, not a cover-everything bound. Observed real
// subagent transcripts have inter-line gaps ranging from tens of seconds up to
// ~2619s (a long silent tool call), and chasing that tail would make a FINISHED
// subagent linger as "working" for the same duration — defeating UC-48's whole
// idle-vs-working purpose. ACCEPTED LIMITATION: a background subagent in a >300s
// SILENT tool call WHILE THE LEAD IS IDLE may briefly read idle until its next
// transcript write. This is bounded by the common-case mitigation that when a
// subagent finishes the lead resumes to process its result, so deriveWorking(lead)
// keeps the session "working" via the OR in conversationName through the
// post-completion window.
const SUBAGENT_STALE_MS = 300000;

// Bounded grace before we FAIL LOUD with `no-transcript`. Covers the entrypoint
// restart `sleep 1` window and a teammate spawn settling; resolution normally
// succeeds within a tick or two when a transcript exists.
const GRACE_MS = 8000;

const POLL_MS = 300;

// Bounded idle before a stranded, COMPLETE trailing line (one written with no
// terminating newline because `claude` is now blocking on an AskUserQuestion /
// ExitPlanMode answer) is flushed live. 3 × POLL_MS (~900ms): long enough that a
// writer mid-line is not mistaken for a blocked one, short enough that the
// question reaches the structured view promptly. The flush only ever fires once
// the residual parses as complete JSON (see idleFlush).
const FLUSH_IDLE_MS = 3 * POLL_MS;

// Exit quietly if the server closed our stdout (EPIPE on write → SIGPIPE-like).
process.stdout.on('error', (e) => {
  if (e && e.code === 'EPIPE') process.exit(0);
});

function out(line) {
  try {
    process.stdout.write(line + '\n');
  } catch (e) {
    if (e && e.code === 'EPIPE') process.exit(0);
  }
}

function emitCtrl(kind) {
  out('__ctrl__\t' + kind);
}

// ──────────────────────── tmux / proc resolution ────────────────────────

function tmuxArgs(rest) {
  const base = [];
  if (ARGS.socket) {
    base.push('-S', ARGS.socket);
  }
  return base.concat(rest);
}

function targetSpec() {
  const s = ARGS.session || 'main';
  if (ARGS.window && ARGS.pane) {
    return s + ':' + ARGS.window + '.' + ARGS.pane;
  }
  return s;
}

/** Resolve the pane pid via `tmux display-message -p -t <spec> '#{pane_pid}'`; null on failure. */
function resolvePanePid() {
  try {
    const res = execFileSync(
      'tmux',
      tmuxArgs(['display-message', '-p', '-t', targetSpec(), '#{pane_pid}']),
      { encoding: 'utf8', timeout: 5000 },
    );
    const pid = parseInt(String(res).trim(), 10);
    return Number.isFinite(pid) && pid > 0 ? pid : null;
  } catch (e) {
    return null;
  }
}

function readProc(p) {
  try {
    return fs.readFileSync(p, 'utf8');
  } catch (e) {
    return null;
  }
}

function readProcLink(p) {
  try {
    return fs.readlinkSync(p);
  } catch (e) {
    return null;
  }
}

function procChildren(pid) {
  const raw = readProc('/proc/' + pid + '/task/' + pid + '/children');
  if (!raw) return [];
  return raw.trim().split(/\s+/).map((s) => parseInt(s, 10)).filter((n) => Number.isFinite(n) && n > 0);
}

function isClaude(pid) {
  const comm = readProc('/proc/' + pid + '/comm');
  if (comm && comm.trim().toLowerCase().startsWith('claude')) return true;
  const cmd = readProc('/proc/' + pid + '/cmdline');
  if (cmd) {
    const argv0 = cmd.split('\0')[0] || '';
    const bn = argv0.substring(argv0.lastIndexOf('/') + 1);
    if (bn.toLowerCase().startsWith('claude')) return true;
  }
  return false;
}

/** DFS from panePid to the first `claude*` descendant; null if none within depth. */
function findClaudePid(panePid, depth) {
  if (panePid == null) return null;
  if (isClaude(panePid)) return panePid;
  if (depth <= 0) return null;
  for (const child of procChildren(panePid)) {
    const found = findClaudePid(child, depth - 1);
    if (found != null) return found;
  }
  return null;
}

// ──────────────────────── identity + slug resolution (pure seams) ────────────────────────

/**
 * Claude Code's transcript directory name for a cwd: every non-alphanumeric char
 * is replaced by '-'. e.g. `/workspace/project-builder` → `-workspace-project-builder`,
 * `/workspace/p/.claude` → `-workspace-p--claude`. (PURE — unit-testable.)
 */
function slugFromCwd(cwd) {
  if (!cwd) return null;
  return String(cwd).replace(/[^a-zA-Z0-9]/g, '-');
}

/**
 * Parse a NUL-separated /proc/<pid>/cmdline into the claude identity tuple.
 * Handles both `--flag value` and `--flag=value` forms. (PURE — unit-testable.)
 * Returns { agentName, teamName, parentSessionId, sessionId } (any may be null).
 * `sessionId` is the main session's own `--session-id` (added by the entrypoint
 * restart loop) — the stable, cmdline-discoverable anchor for the main pane.
 */
function parseClaudeIdentity(cmdlineRaw) {
  const res = { agentName: null, teamName: null, parentSessionId: null, sessionId: null };
  if (!cmdlineRaw) return res;
  const parts = String(cmdlineRaw).split('\0');
  for (let i = 0; i < parts.length; i++) {
    const p = parts[i];
    if (p === '--agent-name') res.agentName = parts[i + 1] || null;
    else if (p === '--team-name') res.teamName = parts[i + 1] || null;
    else if (p === '--parent-session-id') res.parentSessionId = parts[i + 1] || null;
    else if (p === '--session-id') res.sessionId = parts[i + 1] || null;
    else if (p.startsWith('--agent-name=')) res.agentName = p.substring('--agent-name='.length) || null;
    else if (p.startsWith('--team-name=')) res.teamName = p.substring('--team-name='.length) || null;
    else if (p.startsWith('--parent-session-id=')) res.parentSessionId = p.substring('--parent-session-id='.length) || null;
    else if (p.startsWith('--session-id=')) res.sessionId = p.substring('--session-id='.length) || null;
  }
  return res;
}

/**
 * Pick the agent-team transcript from a candidate listing (PURE — unit-testable).
 * candidates: [{ path, mtimeMs, agentName, teamName }]. Match agentName exactly;
 * match teamName when the cmdline carried one (it always does for a teammate).
 * Newest mtime wins. Returns the path or null.
 */
function selectAgentTranscript(candidates, agentName, teamName) {
  let best = null;
  let bestMtime = -1;
  for (const c of candidates) {
    if (!c || c.agentName !== agentName) continue;
    if (teamName && c.teamName && c.teamName !== teamName) continue;
    if (c.mtimeMs > bestMtime) {
      bestMtime = c.mtimeMs;
      best = c.path;
    }
  }
  return best;
}

/**
 * Tier 1 main resolution (PURE — unit-testable). candidates: [{ path, stem, mtimeMs }].
 * Pick the candidate whose stem is one of the orchestrator session ids advertised
 * by a teammate's --parent-session-id; newest mtime if several match. null otherwise.
 */
function selectMainByParent(candidates, parentSessionIds) {
  let best = null;
  let bestMtime = -1;
  for (const c of candidates) {
    if (!c || !parentSessionIds.has(c.stem)) continue;
    if (c.mtimeMs > bestMtime) {
      bestMtime = c.mtimeMs;
      best = c.path;
    }
  }
  return best;
}

/**
 * Tier 2 main resolution (PURE — unit-testable). candidates: [{ path, mtimeMs,
 * agentNamePresent }]. Newest agentName-ABSENT transcript (an orchestrator/solo
 * session never stamps agentName). null if none.
 */
function selectMainNewestNoAgent(candidates) {
  let best = null;
  let bestMtime = -1;
  for (const c of candidates) {
    if (!c || c.agentNamePresent) continue;
    if (c.mtimeMs > bestMtime) {
      bestMtime = c.mtimeMs;
      best = c.path;
    }
  }
  return best;
}

/**
 * Exact main resolution by the session's OWN --session-id (PURE — unit-testable).
 * candidates: [{ path, stem, mtimeMs }]. Returns the candidate whose stem equals
 * sessionId (newest mtime if — pathologically — several share the stem); null if
 * none. NEVER falls through to newest-mtime: a freshly-started session shows an
 * empty/transient `no_transcript` state until its OWN transcript appears, never
 * a foreign session's transcript from the shared (bind-mounted) slug dir.
 */
function selectMainBySessionId(candidates, sessionId) {
  if (!sessionId) return null;
  let best = null;
  let bestMtime = -1;
  for (const c of candidates) {
    if (!c || c.stem !== sessionId) continue;
    if (c.mtimeMs > bestMtime) {
      bestMtime = c.mtimeMs;
      best = c.path;
    }
  }
  return best;
}

/**
 * Decide the main-pane transcript (PURE — unit-testable). Two regimes:
 *   • sessionId present (current entrypoint stamps --session-id): anchor by it
 *     EXACTLY via selectMainBySessionId — and ONLY that. No fallthrough, so a new
 *     session never adopts a foreign transcript while its own is still pending.
 *   • sessionId absent (old-entrypoint degradation): the unchanged two-tier path,
 *     selectMainByParent (Tier 1, teamed) then selectMainNewestNoAgent (Tier 2).
 * candidates carry { path, stem, mtimeMs } and, for the Tier-2 fallback,
 * agentNamePresent. opts: { sessionId, parentSessionIds }. Returns path or null.
 */
function selectMainTranscript(candidates, opts) {
  const sessionId = opts ? opts.sessionId : null;
  const parentSessionIds = (opts && opts.parentSessionIds) || new Set();
  if (sessionId) {
    return selectMainBySessionId(candidates, sessionId);
  }
  const byParent = selectMainByParent(candidates, parentSessionIds);
  if (byParent) return byParent;
  return selectMainNewestNoAgent(candidates);
}

/**
 * UC-65/UC-91 — pick a transcript ROTATION target for a MAIN/orchestrator pane
 * (PURE — unit-testable). candidates: [{ path, stem, mtimeMs, agentNamePresent }].
 * Returns the newest agentName-ABSENT candidate whose mtime is STRICTLY greater
 * than `currentMtimeMs`, whose path differs from `currentPath`, AND that passes the
 * `isOwnLineage` lineage guard, or null when none.
 *
 * This is the signal that claude has rotated past `currentPath` (e.g. after
 * `/clear`, which starts a fresh session jsonl while the process — and its launch
 * --session-id — stay put). Foreign-safety has THREE layers:
 *   1. agentName-present (teammate) transcripts are excluded, so the main pane
 *      never adopts a swarm teammate's file;
 *   2. the strict newer-than-current floor rejects a STALE foreign session;
 *   3. (UC-91) `isOwnLineage(stem)` — the pane-LINEAGE guard. ~/.claude is shared
 *      across sessions on the same cwd-slug (default `./claude-config` mount), so a
 *      CONCURRENTLY-ACTIVE foreign session's main transcript is also agentName-absent
 *      AND newer than this pane's idle launch file — layers 1+2 cannot tell it apart
 *      from this pane's own `/clear` rotation. `isOwnLineage` is the discriminator:
 *      it returns false for any stem owned by a DIFFERENT live session, so a foreign
 *      session's transcript is NEVER adopted, at initial resolution OR mid-stream.
 *
 * `isOwnLineage` is an INJECTABLE predicate `(stem) => boolean` (resolved in the
 * impure caller from the live process table — see collectForeignMainSessionIds).
 * When omitted (legacy callers / pure tests that don't exercise the guard) every
 * stem is treated as adoptable, preserving the pre-UC-91 behavior.
 */
function selectRotatedMain(candidates, currentPath, currentMtimeMs, isOwnLineage) {
  const ownLineage = typeof isOwnLineage === 'function' ? isOwnLineage : () => true;
  let best = null;
  let bestMtime = currentMtimeMs;
  for (const c of candidates) {
    if (!c || c.agentNamePresent) continue;
    if (c.path === currentPath) continue;
    if (!ownLineage(c.stem)) continue; // UC-91 — never adopt a foreign session's file
    if (c.mtimeMs > bestMtime) {
      bestMtime = c.mtimeMs;
      best = c.path;
    }
  }
  return best;
}

/**
 * UC-65/UC-91 — main resolution that FOLLOWS a `/clear` rotation (PURE —
 * unit-testable). candidates: [{ path, stem, mtimeMs, agentNamePresent }]. Anchor by
 * exact --session-id (the launch id); but if claude has rotated past it (a
 * strictly-newer agentName-absent transcript that ALSO belongs to this pane's own
 * lineage) adopt that newest file instead — so a fresh connection AFTER `/clear`
 * backfills the CURRENT transcript, not the stale pre-clear one. Returns null when
 * the launch session-id file is absent, preserving the startup no-foreign-adoption
 * guarantee (a freshly-started session shows a transient no-transcript until its OWN
 * file appears, never a foreign one).
 *
 * `isOwnLineage` (UC-91) is threaded straight into selectRotatedMain — see there.
 * Without it a concurrently-active foreign session in the shared slug would be
 * adopted (the UC-91 cross-session bleed); with it only this pane's own rotation is.
 */
function selectMainCurrent(candidates, sessionId, isOwnLineage) {
  const exact = selectMainBySessionId(candidates, sessionId);
  if (!exact) return null;
  let exactMtime = -1;
  for (const c of candidates) {
    if (c && c.path === exact && c.mtimeMs > exactMtime) exactMtime = c.mtimeMs;
  }
  return selectRotatedMain(candidates, exact, exactMtime, isOwnLineage) || exact;
}

/**
 * UC-91 — the SET of main-pane session ids OWNED BY OTHER live sessions sharing this
 * cwd-slug (PURE — unit-testable). procs: [{ pid, sessionId, agentName }] — one per
 * `claude` process found in the slug. A different session's main pane is agentName-
 * ABSENT and carries its own launch `--session-id`; that id names a transcript stem
 * THIS pane must never adopt as a rotation target. Teammate processes (agentName
 * present) are skipped — they are handled by the (agentName, teamName) agent path,
 * never by main rotation. Our own pid is skipped so our launch id is NOT marked
 * foreign. Returns a Set of foreign session-id strings.
 */
function collectForeignMainSessionIds(procs, ownPid) {
  const ids = new Set();
  for (const p of procs) {
    if (!p || p.pid === ownPid) continue;
    if (p.agentName) continue; // teammate — not a main pane
    if (p.sessionId) ids.add(p.sessionId);
  }
  return ids;
}

/**
 * UC-91 — enumerate every `claude` process whose cwd maps to `slug`, returning
 * [{ pid, sessionId, agentName }] (impure /proc walk). Feeds
 * collectForeignMainSessionIds so the live resolver can build the pane-lineage
 * guard. Cheap: a single /proc readdir plus a cmdline+cwd read per claude pid, and
 * it only runs on the rotation path (a candidate strictly newer than our anchor).
 */
function enumerateSlugClaudeMains(slug) {
  const out = [];
  let pids;
  try {
    pids = fs.readdirSync('/proc');
  } catch (e) {
    return out;
  }
  for (const ent of pids) {
    if (!/^\d+$/.test(ent)) continue;
    const pid = parseInt(ent, 10);
    if (!isClaude(pid)) continue;
    const cwd = readProcLink('/proc/' + pid + '/cwd');
    if (!cwd || slugFromCwd(cwd) !== slug) continue;
    const idn = parseClaudeIdentity(readProc('/proc/' + pid + '/cmdline'));
    out.push({ pid, sessionId: idn.sessionId, agentName: idn.agentName });
  }
  return out;
}

/**
 * UC-91 — build the pane-lineage guard `(stem) => boolean` for a MAIN pane resolved
 * to `claudePid` in `slug` (impure). Returns a predicate that is false for any stem
 * owned by a DIFFERENT live session, so selectRotatedMain never adopts a foreign
 * session's transcript. Falls back safely: if the process table can't be read the
 * guard rejects ALL rotation (predicate over an empty foreign set still excludes
 * nothing, but the strict mtime floor + exact anchor keep us on our own file), which
 * matches the approved fallback — never foreign adoption.
 */
function ownLineagePredicate(slug, claudePid) {
  const foreign = collectForeignMainSessionIds(enumerateSlugClaudeMains(slug), claudePid);
  return (stem) => !foreign.has(stem);
}

/** List top-level <slug>/*.jsonl as [{ path, stem, mtimeMs }] (impure FS read). */
function listTopLevelTranscripts(slugDir) {
  let entries;
  try {
    entries = fs.readdirSync(slugDir);
  } catch (e) {
    return [];
  }
  const result = [];
  for (const ent of entries) {
    if (!ent.endsWith('.jsonl')) continue;
    const p = path.join(slugDir, ent);
    let st;
    try {
      st = fs.statSync(p);
    } catch (e) {
      continue;
    }
    if (!st.isFile()) continue;
    result.push({ path: p, stem: ent.substring(0, ent.length - '.jsonl'.length), mtimeMs: st.mtimeMs });
  }
  return result;
}

/**
 * Sniff a transcript's identity from a bounded head read (impure FS read).
 * Returns { agentNamePresent, agentName, teamName }. Only the head is read
 * because the (agentName, teamName) stamp lands at the very top of the file.
 */
function readTranscriptIdentity(filePath, maxBytes) {
  let fd;
  try {
    fd = fs.openSync(filePath, 'r');
  } catch (e) {
    return { agentNamePresent: false, agentName: null, teamName: null };
  }
  let text = '';
  try {
    const st = fs.fstatSync(fd);
    const len = Math.min(maxBytes, st.size);
    if (len > 0) {
      const buf = Buffer.allocUnsafe(len);
      const read = fs.readSync(fd, buf, 0, len, 0);
      text = buf.toString('utf8', 0, read);
    }
  } catch (e) {
    /* best-effort */
  } finally {
    try { fs.closeSync(fd); } catch (e) { /* ignore */ }
  }
  const lines = text.split('\n');
  // Drop a trailing partial line (no newline terminator within the head window).
  if (lines.length > 0) lines.pop();
  let agentName = null;
  let teamName = null;
  let agentNamePresent = false;
  for (const l of lines) {
    if (!l) continue;
    // Cheap pre-filter before the JSON.parse.
    if (l.indexOf('"agentName"') < 0 && l.indexOf('"teamName"') < 0) continue;
    let o;
    try { o = JSON.parse(l); } catch (e) { continue; }
    if (o && typeof o.agentName === 'string' && o.agentName.length > 0) {
      agentName = o.agentName;
      agentNamePresent = true;
    }
    if (o && typeof o.teamName === 'string' && o.teamName.length > 0) {
      teamName = o.teamName;
    }
    if (agentNamePresent && teamName) break;
  }
  return { agentNamePresent, agentName, teamName };
}

/** Collect --parent-session-id values from claude procs sharing this cwd-slug (impure). */
function collectParentSessionIds(slug) {
  const ids = new Set();
  let pids;
  try {
    pids = fs.readdirSync('/proc');
  } catch (e) {
    return ids;
  }
  for (const ent of pids) {
    if (!/^\d+$/.test(ent)) continue;
    const pid = parseInt(ent, 10);
    const cmd = readProc('/proc/' + pid + '/cmdline');
    if (!cmd || cmd.indexOf('--parent-session-id') < 0) continue;
    if (!isClaude(pid)) continue;
    const cwd = readProcLink('/proc/' + pid + '/cwd');
    if (!cwd || slugFromCwd(cwd) !== slug) continue;
    const idn = parseClaudeIdentity(cmd);
    if (idn.parentSessionId) ids.add(idn.parentSessionId);
  }
  return ids;
}

/**
 * Resolve the active transcript for an already-resolved claude PID via identity
 * + cwd-slug (impure orchestration over the pure seams above). Returns an
 * absolute path or null.
 */
function resolveTranscriptForClaude(claudePid) {
  if (claudePid == null) return null;
  const cwd = readProcLink('/proc/' + claudePid + '/cwd');
  const slug = slugFromCwd(cwd);
  if (!slug) return null;
  const slugDir = path.join(ARGS.projectsDir, slug);
  const idn = parseClaudeIdentity(readProc('/proc/' + claudePid + '/cmdline'));
  const candidates = listTopLevelTranscripts(slugDir);
  if (candidates.length === 0) return null;

  if (idn.agentName) {
    // Teammate / subagent pane — anchor by (agentName, teamName).
    const enriched = candidates.map((c) => {
      const id = readTranscriptIdentity(c.path, ID_SCAN_BYTES);
      return { path: c.path, mtimeMs: c.mtimeMs, agentName: id.agentName, teamName: id.teamName };
    });
    return selectAgentTranscript(enriched, idn.agentName, idn.teamName);
  }

  // Main / orchestrator pane — delegate the decision to selectMainTranscript.
  if (idn.sessionId) {
    // Current entrypoint: anchor by our own --session-id, but FOLLOW a `/clear`
    // rotation (UC-65) — if claude has started a newer agentName-absent session
    // jsonl, adopt it so a fresh connection backfills the CURRENT transcript, not
    // the stale pre-clear one. Still no foreign adoption: selectMainCurrent returns
    // null until our own launch file exists, and only ever adopts a file NEWER than
    // it. Enrich with agentNamePresent so the rotation filter can exclude teammates.
    const enrichedMain = candidates.map((c) => {
      const id = readTranscriptIdentity(c.path, ID_SCAN_BYTES);
      return { path: c.path, stem: c.stem, mtimeMs: c.mtimeMs, agentNamePresent: id.agentNamePresent };
    });
    // UC-91 — pane-lineage guard so a concurrently-active FOREIGN session in the
    // shared slug is never adopted as our `/clear` rotation target.
    return selectMainCurrent(enrichedMain, idn.sessionId, ownLineagePredicate(slug, claudePid));
  }
  // Old-entrypoint degradation (no --session-id on cmdline): Tier 1 parent-anchor
  // then Tier 2 newest agentName-absent. Enrich with agentNamePresent for Tier 2.
  const parentIds = collectParentSessionIds(slug);
  const enriched = candidates.map((c) => {
    const id = readTranscriptIdentity(c.path, ID_SCAN_BYTES);
    return { path: c.path, stem: c.stem, mtimeMs: c.mtimeMs, agentNamePresent: id.agentNamePresent };
  });
  return selectMainTranscript(enriched, { parentSessionIds: parentIds });
}

/**
 * One-shot resolve for the current target pane, returning the FULL context the
 * UC-59 delegate scan needs: the main transcript path plus the lead's claudePid and
 * cwd-slug. (impure.) `mainPath`/`claudePid`/`slug` may each be null on a miss.
 */
function resolveMainContextOnce() {
  const panePid = resolvePanePid();
  const claudePid = findClaudePid(panePid, 3);
  const mainPath = resolveTranscriptForClaude(claudePid);
  const cwd = claudePid != null ? readProcLink('/proc/' + claudePid + '/cwd') : null;
  const slug = slugFromCwd(cwd);
  return { mainPath, claudePid, slug };
}

/** One-shot resolve for the current target pane (used by --scan-pending). */
function resolveTranscriptOnce() {
  return resolveMainContextOnce().mainPath;
}

/**
 * UC-65 — detect a same-PID transcript ROTATION for an already-anchored pane
 * (impure orchestration over the pure selectors). The live loop re-resolves only
 * on a claude PID change (entrypoint restart), but `/clear` rotates claude to a
 * NEW jsonl WITHOUT a restart, so the anchor would otherwise stay pinned to the
 * stale pre-clear file and no post-clear turns would ever stream (AC5/AC8).
 *
 * Returns the path claude is CURRENTLY writing when it differs from `currentPath`
 * (→ caller rebaselines), or null when there is no rotation. Cheap on the steady
 * state: a readdir + stat per poll, and the (heavier) per-candidate identity sniff
 * runs ONLY when some candidate is strictly newer than the anchored file — the
 * rotation signal. Foreign-safe: a teammate pane stays within its (agentName,
 * teamName) family; a main pane only adopts a newer agentName-ABSENT file.
 */
function detectRotation(claudePid, currentPath) {
  if (claudePid == null || !currentPath) return null;
  const cwd = readProcLink('/proc/' + claudePid + '/cwd');
  const slug = slugFromCwd(cwd);
  if (!slug) return null;
  const slugDir = path.join(ARGS.projectsDir, slug);
  const candidates = listTopLevelTranscripts(slugDir);
  if (candidates.length === 0) return null;
  // Cheap pre-check: only proceed if a candidate is strictly newer than the file we
  // are anchored to. On the steady state our own file is the freshest, so this
  // returns immediately without sniffing any identities.
  const cur = candidates.find((c) => c.path === currentPath);
  const curMtime = cur ? cur.mtimeMs : -1;
  let freshest = -1;
  for (const c of candidates) {
    if (c.mtimeMs > freshest) freshest = c.mtimeMs;
  }
  if (freshest <= curMtime) return null;
  const idn = parseClaudeIdentity(readProc('/proc/' + claudePid + '/cmdline'));
  if (idn.agentName) {
    // Teammate / subagent pane — newest within the (agentName, teamName) family.
    const enriched = candidates.map((c) => {
      const id = readTranscriptIdentity(c.path, ID_SCAN_BYTES);
      return { path: c.path, mtimeMs: c.mtimeMs, agentName: id.agentName, teamName: id.teamName };
    });
    const sel = selectAgentTranscript(enriched, idn.agentName, idn.teamName);
    return sel && sel !== currentPath ? sel : null;
  }
  // Main / orchestrator pane — adopt a strictly-newer agentName-ABSENT file, but
  // ONLY within this pane's own lineage (UC-91): a concurrently-active foreign
  // session's main transcript is also agentName-absent and newer, so without the
  // lineage guard the live stream would HOP B onto A mid-stream (the sticky bleed).
  const enriched = candidates.map((c) => {
    const id = readTranscriptIdentity(c.path, ID_SCAN_BYTES);
    return { path: c.path, stem: c.stem, mtimeMs: c.mtimeMs, agentNamePresent: id.agentNamePresent };
  });
  const sel = selectRotatedMain(enriched, currentPath, curMtime, ownLineagePredicate(slug, claudePid));
  return sel && sel !== currentPath ? sel : null;
}

/** subagents/agent-*.jsonl directory derived from the main transcript path. */
function subagentDir(mainPath) {
  const dir = path.dirname(mainPath);
  const stem = path.basename(mainPath, '.jsonl');
  return path.join(dir, stem, 'subagents');
}

function listSubagentFiles(mainPath) {
  const dir = subagentDir(mainPath);
  let files;
  try {
    files = fs.readdirSync(dir);
  } catch (e) {
    return [];
  }
  return files
    .filter((f) => f.startsWith('agent-') && f.endsWith('.jsonl'))
    .map((f) => path.join(dir, f));
}

function subagentSource(filePath) {
  return 'subagent:' + subagentId(filePath);
}

/** The bare subagent agent id from a <…>/subagents/agent-<id>.jsonl path. (PURE) */
function subagentId(filePath) {
  const bn = path.basename(filePath, '.jsonl'); // agent-<id>
  return bn.startsWith('agent-') ? bn.substring('agent-'.length) : bn;
}

/**
 * UC-60 — a short, stable display label for a subagent pill (PURE — exported for QA).
 * Sniffs the bounded file head for the subagent's TYPE/DESCRIPTION (the harness writes
 * `subagentType`/`agent_type`/`agentType` and/or a `description`/`task` at the top of a
 * subagent transcript), preferring a concise `<type>` and otherwise floors to
 * `agent <shortid>` (the first 8 chars of the id) so a pill is never blank. `headText`
 * is the already-read head of the file (kept impure-free for unit testing).
 */
function subagentLabelFromHead(headText, id) {
  const floor = 'agent ' + String(id || '').slice(0, 8);
  if (typeof headText !== 'string' || headText.length === 0) return floor;
  const lines = headText.split('\n');
  // Drop a trailing partial line our head window may have sliced through.
  if (lines.length > 0) lines.pop();
  for (const l of lines) {
    if (!l) continue;
    if (
      l.indexOf('subagentType') < 0 &&
      l.indexOf('agent_type') < 0 &&
      l.indexOf('agentType') < 0 &&
      l.indexOf('subagent_type') < 0
    ) {
      continue;
    }
    let o;
    try { o = JSON.parse(l); } catch (e) { continue; }
    if (!o || typeof o !== 'object') continue;
    const type = o.subagentType || o.subagent_type || o.agentType || o.agent_type;
    if (typeof type === 'string' && type.trim() !== '') {
      return sanitizeOneLine(type);
    }
  }
  return floor;
}

/** Read a subagent file's head and derive its pill label (impure FS read). */
function subagentLabel(filePath, id) {
  let headText = '';
  let fd;
  try {
    fd = fs.openSync(filePath, 'r');
    const st = fs.fstatSync(fd);
    const len = Math.min(ID_SCAN_BYTES, st.size);
    if (len > 0) {
      const buf = Buffer.allocUnsafe(len);
      const read = fs.readSync(fd, buf, 0, len, 0);
      headText = buf.toString('utf8', 0, read);
    }
  } catch (e) {
    /* best-effort — fall through to the floor label */
  } finally {
    if (fd !== undefined) {
      try { fs.closeSync(fd); } catch (e) { /* ignore */ }
    }
  }
  return subagentLabelFromHead(headText, id);
}

/**
 * UC-59 — read the LAST `maxBytes` of a transcript and return its COMPLETE lines
 * (impure FS read, O(1) regardless of file size). Exported for QA. Mirrors
 * {@link readTranscriptIdentity}'s bounded read but anchored at the END: seek to
 * max(0, size - maxBytes), read to EOF, then drop the partial lines our window may
 * have sliced through — the LEADING partial (when we started mid-file, the first
 * element is an incomplete JSON fragment) and the TRAILING partial (no terminating
 * newline). The surviving complete lines feed the PURE deriveWorking unchanged.
 * `stat`-cheap callers should short-circuit before calling this. Returns string[].
 */
function readBoundedTailLines(filePath, maxBytes) {
  let fd;
  try {
    fd = fs.openSync(filePath, 'r');
  } catch (e) {
    return [];
  }
  let text = '';
  let startedMidFile = false;
  try {
    const st = fs.fstatSync(fd);
    const size = st.size;
    const len = Math.min(maxBytes, size);
    const start = size - len;
    startedMidFile = start > 0;
    if (len > 0) {
      const buf = Buffer.allocUnsafe(len);
      const read = fs.readSync(fd, buf, 0, len, start);
      text = buf.toString('utf8', 0, read);
    }
  } catch (e) {
    /* best-effort */
  } finally {
    try { fs.closeSync(fd); } catch (e) { /* ignore */ }
  }
  if (!text) return [];
  const lines = text.split('\n');
  // Drop the trailing element: it is either '' (file ended with a newline) or a
  // partial last line — mirror readAllLines, which always pops it.
  if (lines.length > 0) lines.pop();
  // Drop a leading partial line only when our window started mid-file (its first
  // element is an incomplete JSON fragment we cannot parse).
  if (startedMidFile && lines.length > 0) lines.shift();
  return lines.filter((l) => l.length > 0);
}

/**
 * UC-59 — is ANY delegate (team agent OR background subagent) of the main pane
 * currently working? (impure — /proc scan + bounded transcript reads.) deriveWorking
 * stays PURE/unchanged; this is the additive delegate-aware layer wired into
 * {@link conversationName}, so the sessions-list "working" spinner reflects real
 * activity even when the lead has delegated and ended its own turn (gone idle).
 * TYPE-SPLIT by delegate kind, because the two have different liveness signals:
 *
 *  • Team agents — SEPARATE `claude` OS processes whose cmdline carries
 *    --agent-name and --parent-session-id === our `mainStem`. pid-liveness is the
 *    PRIMARY gate (mirrors collectParentSessionIds, inverted): a dead/zombie
 *    teammate has no proc and is simply excluded, so the analyst-zombie case never
 *    false-positives to "working". For each LIVE teammate we resolve its active
 *    transcript and ask deriveWorking — a teammate mid-tool has a tool_use tail →
 *    "working" with NO dependence on recent writes, so NO mtime gate is applied (a
 *    long :server:test must never false-negative to idle). Teammate transcripts DO
 *    emit turn_duration, so a live-but-idle teammate correctly reads idle.
 *  • Background subagents — IN-PROCESS under the lead (no pid). Gated on
 *    deriveWorking AND an mtime freshness window (SUBAGENT_STALE_MS), because a
 *    subagent transcript never emits a turn-end (see SUBAGENT_STALE_MS). The mtime
 *    gate is the real completion/crash signal here; deriveWorking is kept in the AND
 *    as belt-and-suspenders for any future build that does emit a subagent turn-end.
 *
 * `slug` is accepted for API symmetry with the resolver context but is intentionally
 * unused: a teammate runs in its OWN team-definition cwd (a different slug than the
 * lead), so parentSessionId === mainStem is the exact, sufficient anchor. `nowMs` is
 * injectable for deterministic tests. Returns true if any delegate is working.
 */
function anyDelegateWorking(mainPath, mainStem, slug, claudePid, nowMs) {
  if (!mainPath || !mainStem) return false;
  if (nowMs === undefined) nowMs = Date.now();
  // ── Team agents: /proc scan for live claude procs parented to our session ──
  let pids;
  try {
    pids = fs.readdirSync('/proc');
  } catch (e) {
    pids = [];
  }
  for (const ent of pids) {
    if (!/^\d+$/.test(ent)) continue;
    const pid = parseInt(ent, 10);
    if (claudePid != null && pid === claudePid) continue; // never count the lead itself
    const cmd = readProc('/proc/' + pid + '/cmdline');
    if (!cmd || cmd.indexOf('--parent-session-id') < 0) continue;
    if (!isClaude(pid)) continue;
    const idn = parseClaudeIdentity(cmd);
    if (idn.parentSessionId !== mainStem) continue; // only OUR delegates
    const tPath = resolveTranscriptForClaude(pid); // a LIVE pid → resolvable transcript
    if (!tPath) continue;
    if (deriveWorking(readBoundedTailLines(tPath, TAIL_SCAN_BYTES))) return true;
  }
  // ── Background subagents: <mainStem>/subagents/agent-*.jsonl ──
  for (const sf of listSubagentFiles(mainPath)) {
    const st = statSafe(sf);
    if (!st) continue;
    if (nowMs - st.mtimeMs > SUBAGENT_STALE_MS) continue; // aged out → finished/crashed
    if (deriveWorking(readBoundedTailLines(sf, TAIL_SCAN_BYTES))) return true;
  }
  return false;
}

// ──────────────────────── line splitting with residual buffer ────────────────────────

/**
 * Tracks per-file byte offset + a residual partial-line buffer for complete-line
 * emission. The idle-flush fields support live delivery of a stranded trailing
 * line (UC-40):
 *   residualSinceMs — the clock value when `residual` last GREW (new bytes
 *     arrived), or null when residual is empty. The idle timer is measured from
 *     here; it resets on every append, so an actively-written line is never
 *     mistaken for a blocked one.
 *   pendingFlushed  — the exact residual string already emitted live via
 *     idleFlush, or null. Doubles as the one-shot guard (don't reflush the same
 *     residual) and the suppression key (drop the one eventual newline-terminated
 *     copy of that string).
 */
function makeReader(filePath, source) {
  return { filePath, source, offset: 0, residual: '', ino: null, residualSinceMs: null, pendingFlushed: null };
}

function statSafe(p) {
  try {
    return fs.statSync(p);
  } catch (e) {
    return null;
  }
}

/**
 * Read new complete lines from reader since its offset; returns array of lines
 * (no newline). `nowMs` (injectable clock, default Date.now()) stamps when the
 * residual last grew, so the idle-flush timer (idleFlush) is deterministic under
 * test.
 */
function readNewLines(reader, nowMs) {
  if (nowMs === undefined) nowMs = Date.now();
  const st = statSafe(reader.filePath);
  if (!st) return [];
  // Rotation / truncation: file shrank or inode changed → reset to start. Also
  // clear the idle-flush bookkeeping so a rotated file starts clean and never
  // suppresses a legitimate line on the strength of a stale pendingFlushed.
  if (reader.ino != null && (st.ino !== reader.ino || st.size < reader.offset)) {
    reader.offset = 0;
    reader.residual = '';
    reader.residualSinceMs = null;
    reader.pendingFlushed = null;
  }
  reader.ino = st.ino;
  // No-growth poll tick: return WITHOUT touching residualSinceMs, so the idle
  // timer keeps accumulating toward FLUSH_IDLE_MS while the writer is blocked.
  if (st.size <= reader.offset) return [];
  let fd;
  try {
    fd = fs.openSync(reader.filePath, 'r');
  } catch (e) {
    return [];
  }
  const lines = [];
  let read = 0;
  try {
    const len = st.size - reader.offset;
    const buf = Buffer.allocUnsafe(len);
    read = fs.readSync(fd, buf, 0, len, reader.offset);
    reader.offset += read;
    if (read > 0) reader.residual += buf.toString('utf8', 0, read);
    let nl;
    while ((nl = reader.residual.indexOf('\n')) >= 0) {
      const line = reader.residual.substring(0, nl);
      reader.residual = reader.residual.substring(nl + 1);
      // If this exact line was already delivered live by idleFlush, drop this one
      // newline-terminated copy (one-shot) instead of double-emitting it. Keyed on
      // the trimmed flushed string, so a legitimately repeated identical line still
      // emits (pendingFlushed is cleared after the single suppression).
      if (reader.pendingFlushed != null && line.trim() === reader.pendingFlushed.trim()) {
        reader.pendingFlushed = null;
        continue;
      }
      if (line.length > 0) lines.push(line);
    }
  } catch (e) {
    /* best-effort */
  } finally {
    try { fs.closeSync(fd); } catch (e) { /* ignore */ }
  }
  // Idle-timer bookkeeping (placed AFTER the early-return above): a growing
  // residual resets the timer (writer active); an emptied residual clears it and
  // any pending suppression key.
  if (reader.residual) {
    if (read > 0) reader.residualSinceMs = nowMs;
  } else {
    reader.residualSinceMs = null;
    reader.pendingFlushed = null;
  }
  return lines;
}

/**
 * Idle/safety-net flush (UC-40). When a reader's `residual` holds a COMPLETE,
 * parseable JSON line that has not grown for FLUSH_IDLE_MS — the signature of
 * `claude` having written an assistant message (+ its AskUserQuestion /
 * ExitPlanMode tool_use) and then blocked awaiting the answer, with no trailing
 * newline yet — return that line so it can be delivered live. Returns null
 * otherwise (timer not elapsed, residual empty/half-written, or already flushed).
 *
 * CRITICAL invariants:
 *   • NEVER mutates `offset` or `residual` — the eventual real newline is consumed
 *     normally by readNewLines, which then sees pendingFlushed and drops the one
 *     duplicate. Half-written / un-parseable residual is NEVER emitted.
 *   • One-shot per residual (pendingFlushed === residual guard) so a still-blocked
 *     session is not re-flushed every poll.
 * `nowMs` is the injectable clock (default Date.now()) for deterministic tests.
 */
function idleFlush(reader, nowMs) {
  if (nowMs === undefined) nowMs = Date.now();
  if (!reader.residual) return null;
  if (reader.pendingFlushed === reader.residual) return null; // already flushed this exact residual
  if (reader.residualSinceMs == null) return null;
  if (nowMs - reader.residualSinceMs < FLUSH_IDLE_MS) return null;
  try {
    JSON.parse(reader.residual.trim());
  } catch (e) {
    return null; // not complete JSON yet — never emit a half-written line
  }
  // Mark one-shot: readNewLines suppresses the matching newline-terminated copy.
  reader.pendingFlushed = reader.residual;
  return reader.residual;
}

/** Read the whole file as complete lines (for backfill); ignores a trailing partial line. */
function readAllLines(filePath) {
  let content;
  try {
    content = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    return [];
  }
  const parts = content.split('\n');
  // Drop the trailing element if the file did not end with a newline (partial line).
  if (parts.length > 0 && parts[parts.length - 1] === '') parts.pop();
  else if (parts.length > 0) parts.pop(); // last is a partial line; skip it for backfill safety
  return parts.filter((l) => l.length > 0);
}

// ──────────────────────── scan-pending (one-shot) ────────────────────────

// NON-GOAL for UC-40: scanPending / AC18 switcher badging is intentionally left
// unchanged — it reads only complete (newline-terminated) lines and deliberately
// drops a trailing partial; the UC-40 idle flush is a streaming-mode concern only.
//
// KNOWN LATENT GAP (UC-49, out of scope here): scanPending derives "pending" from
// the TRANSCRIPT tail, which shares the same blindness UC-48/UC-49 hit — a live,
// awaiting-answer AskUserQuestion is NOT persisted to the transcript while Claude
// blocks, so the UC-37 switcher badge can miss it. UC-49 fixes only the
// sessions-list row (via the visible-pane capture in conversationName); aligning
// the switcher badge to the same pane signal is deferred, NOT done here.
function scanPending() {
  const mainPath = resolveTranscriptOnce();
  if (!mainPath) {
    out('idle');
    return;
  }
  const all = readAllLines(mainPath);
  const tail = all.slice(Math.max(0, all.length - 60));
  let lastAsk = -1;
  let lastTurnEnd = -1;
  let lastLineIsTurnEnd = false;
  for (let i = 0; i < tail.length; i++) {
    let o;
    try { o = JSON.parse(tail[i]); } catch (e) { continue; }
    if (o && o.type === 'system' && o.subtype === 'turn_duration') {
      lastTurnEnd = i;
      lastLineIsTurnEnd = i === tail.length - 1;
    } else {
      lastLineIsTurnEnd = false;
    }
    if (o && o.type === 'assistant' && o.message && Array.isArray(o.message.content)) {
      for (const b of o.message.content) {
        if (b && b.type === 'tool_use' && b.name === 'AskUserQuestion') lastAsk = i;
      }
    }
  }
  if (lastAsk >= 0 && lastAsk > lastTurnEnd) {
    out('pending-question');
  } else if (tail.length > 0 && !lastLineIsTurnEnd) {
    out('pending-activity');
  } else {
    out('idle');
  }
}

// ──────────────────────── fetch-detail (one-shot) ────────────────────────

/**
 * UC-41 (AC5/AC9) — pure seam (exported for QA): given the main + subagent
 * transcript line sets, return the matched `<source>\t<raw>` envelope lines for one
 * `toolUseId` — the `tool_use` block whose `id` matches (→ full input) and the
 * `tool_result` block whose `tool_use_id` matches (→ full result). Lines are kept
 * WHOLE (valid JSON) so the server can parse them; total emitted bytes are bounded
 * by `maxBytes` (oversize extras dropped). Returns [] when nothing matches.
 *
 * @param toolUseId the tool call id to match
 * @param sources   [{ source: 'main'|'subagent:<id>', lines: [rawJsonString,...] }, ...]
 * @param maxBytes  total byte ceiling (defaults to DETAIL_OUTPUT_CAP_BYTES)
 */
function collectToolDetail(toolUseId, sources, maxBytes) {
  if (!toolUseId || !Array.isArray(sources)) return [];
  const cap = maxBytes || DETAIL_OUTPUT_CAP_BYTES;
  const matched = [];
  let total = 0;
  for (const src of sources) {
    if (!src || !Array.isArray(src.lines)) continue;
    const source = src.source || 'main';
    for (const raw of src.lines) {
      if (!raw) continue;
      let o;
      try { o = JSON.parse(raw); } catch (e) { continue; }
      let hit = false;
      // UC-42 (D3) — a harness-injected line (e.g. a Skill SKILL.md body) carries the
      // host tool's id at the TOP LEVEL as `sourceToolUseID`, NOT inside a
      // tool_use/tool_result block. Match it FIRST, before the array-content guard, so
      // the folded body reaches the server as the Skill bubble's tap detail.
      if (o && o.sourceToolUseID === toolUseId) { hit = true; }
      if (!hit) {
        const content = o && o.message ? o.message.content : null;
        if (!Array.isArray(content)) continue;
        for (const b of content) {
          if (!b || typeof b !== 'object') continue;
          if (b.type === 'tool_use' && b.id === toolUseId) { hit = true; break; }
          if (b.type === 'tool_result' && b.tool_use_id === toolUseId) { hit = true; break; }
        }
      }
      if (!hit) continue;
      const line = source + '\t' + raw;
      const bytes = Buffer.byteLength(line, 'utf8');
      if (total > 0 && total + bytes > cap) continue; // flood-guard; keep lines whole
      matched.push(line);
      total += bytes;
    }
  }
  return matched;
}

/**
 * UC-41 (AC5/AC9) — one-shot resolve of the active transcript, scan main +
 * subagent files for `toolUseId`, and print the matched raw envelope lines (the
 * server re-renders them untruncated). Emits `__ctrl__\tdetail-not-found` on an
 * unresolvable transcript or a no-match, so the server maps it to `available=false`.
 */
function fetchDetail() {
  const id = ARGS.toolUseId;
  if (!id) { emitCtrl(CTRL_DETAIL_NOT_FOUND); return; }
  const mainPath = resolveTranscriptOnce();
  if (!mainPath) { emitCtrl(CTRL_DETAIL_NOT_FOUND); return; }
  const sources = [{ source: 'main', lines: readAllLines(mainPath) }];
  for (const f of listSubagentFiles(mainPath)) {
    sources.push({ source: subagentSource(f), lines: readAllLines(f) });
  }
  const matched = collectToolDetail(id, sources, DETAIL_OUTPUT_CAP_BYTES);
  if (matched.length === 0) { emitCtrl(CTRL_DETAIL_NOT_FOUND); return; }
  for (const line of matched) out(line);
}

// ──────────────────────── fetch-page (one-shot) ────────────────────────

/**
 * UC-79 (AC2/AC6/AC7) — compute the older "page" slice for an infinite-scroll
 * load-older request (PURE — exported for QA). Given the file's complete-line
 * array (the readAllLines index space) and the server's current oldest-line
 * cursor `beforeLine`, returns the contiguous slice ending just below `beforeLine`
 * with at most `count` lines, BUDGETED to `capBytes`. To stay contiguous with the
 * already-loaded window the budget is spent from the NEWEST line of the slice
 * downward, so a cap truncation drops the OLDEST lines (never leaving a gap next
 * to `beforeLine`); the returned `start` is the index of the oldest line actually
 * delivered (the server's NEW cursor) and `atStart` is true iff that start is 0.
 * Each delivered line is the normal `main\t<raw>` envelope.
 */
function computePageSlice(allLines, beforeLine, count, capBytes) {
  const cap = capBytes || DETAIL_OUTPUT_CAP_BYTES;
  const end = Math.min(Math.max(0, beforeLine || 0), allLines.length);
  const lowerBound = Math.max(0, end - Math.max(1, count || 1));
  let total = 0;
  let start = end;
  const picked = [];
  for (let i = end - 1; i >= lowerBound; i--) {
    const line = 'main\t' + allLines[i];
    const bytes = Buffer.byteLength(line, 'utf8');
    if (total > 0 && total + bytes > cap) break; // budget spent; keep lines whole
    picked.push(line);
    total += bytes;
    start = i;
  }
  picked.reverse(); // emit oldest→newest so the prepend keeps transcript order (AC6)
  return { start: start, atStart: start === 0, lines: picked };
}

/**
 * UC-79 — one-shot "load older page": resolve the active PRIMARY transcript once,
 * read its complete lines, and print the slice [max(0, before-count), before) each
 * as a `main\t<raw>` envelope, preceded by `__ctrl__\tpage-meta\t<start>\t<atStart>`.
 * Empty/rotated/unresolvable transcript degrades gracefully (mirrors --fetch-detail
 * NOT_FOUND): emit a page-meta with no lines and atStart=1 so the client stops
 * paging rather than hanging.
 */
function fetchPage() {
  const before = ARGS.beforeLine == null ? 0 : ARGS.beforeLine;
  const count = ARGS.count;
  const mainPath = resolveTranscriptOnce();
  if (!mainPath) {
    out('__ctrl__\t' + CTRL_PAGE_META + '\t' + before + '\t1');
    return;
  }
  const all = readAllLines(mainPath);
  const slice = computePageSlice(all, before, count, DETAIL_OUTPUT_CAP_BYTES);
  out('__ctrl__\t' + CTRL_PAGE_META + '\t' + slice.start + '\t' + (slice.atStart ? 1 : 0));
  for (const line of slice.lines) out(line);
}

// ──────────────────────── conversation-name (one-shot) ────────────────────────

// UC-47 — codepoint cap on an emitted conversation name. The server re-caps at
// 120 codepoints too (ConversationNameService.MAX_NAME_CODEPOINTS); capping here
// as well keeps the emitted envelope small and the two ends consistent.
const CONVERSATION_NAME_MAX_CP = 120;

/** Collapse any run of whitespace (newlines/tabs/spaces) to a single space; trim. (PURE) */
function sanitizeOneLine(s) {
  if (typeof s !== 'string') return '';
  return s.replace(/\s+/g, ' ').trim();
}

/** Truncate to at most `maxCp` Unicode codepoints (never splits a surrogate pair). (PURE) */
function capCodepoints(s, maxCp) {
  if (typeof s !== 'string') return '';
  const cps = Array.from(s); // iterates by codepoint, not UTF-16 unit
  if (cps.length <= maxCp) return s;
  return cps.slice(0, maxCp).join('');
}

/** Sanitize → cap → null-if-empty. (PURE) */
function finalizeName(raw) {
  const clean = sanitizeOneLine(raw);
  if (clean === '') return null;
  return capCodepoints(clean, CONVERSATION_NAME_MAX_CP);
}

/**
 * Decide whether a `type:"user"` line is NOT the user's own prompt and must be
 * skipped (PURE — mirror of the server ConversationEventMapper.mapUser classifier,
 * lines ~255-311). Structural markers only:
 *   • top-level sourceToolUseID nonblank → a folded harness/Skill body, not a prompt
 *   • isMeta === true → a harness system note
 *   • content array carrying a tool_result block → a tool result, not a prompt
 *   • string content that is a <command-name>…</command-name> + <command-args>
 *     wrapper, or a <local-command-stdout> wrapper → a slash-command echo
 *   • string content that is a <teammate-message …>…</teammate-message> envelope
 *     → an inbound teammate/subagent message (UC-58), not the lead's own prompt
 */
function isNonPromptUserLine(o) {
  if (!o) return true;
  if (typeof o.sourceToolUseID === 'string' && o.sourceToolUseID.trim() !== '') return true;
  if (o.isMeta === true) return true;
  const content = o.message ? o.message.content : undefined;
  if (Array.isArray(content)) {
    for (const b of content) {
      if (b && b.type === 'tool_result') return true;
    }
  }
  if (typeof content === 'string') {
    const s = content.trim();
    if (s.startsWith('<command-name>') && s.indexOf('</command-name>') >= 0 && s.indexOf('<command-args>') >= 0) {
      return true;
    }
    if (s.startsWith('<local-command-stdout>')) return true;
    // UC-58 — a teammate-message envelope is an inbound teammate/subagent message, not the
    // user's own prompt, so it must never name the conversation or drive turn-state. Keyed
    // off the opening tag at the START of content (the char after the tag name must be a tag
    // boundary), so a genuine prompt that merely mentions the text is not skipped.
    if (s.startsWith('<teammate-message')) {
      const after = s.charAt('<teammate-message'.length);
      if (after === '' || after === '>' || after === '/' || /\s/.test(after)) return true;
    }
  }
  return false;
}

/**
 * Extract a user line's text by its ACTUAL content shape (PURE — mirror of the
 * server extractUserText/blocks, lines ~459-491):
 *   • string content → the string DIRECTLY (the 253/263 common case)
 *   • array content   → concatenate the `text` blocks
 * Deliberately does NOT apply an array-only guard (the fetch-detail helper line
 * ~778 `if (!Array.isArray(content)) continue`): that guard would drop string
 * content and make this ALWAYS return '' for the common case.
 */
function extractUserText(content) {
  if (typeof content === 'string') return content;
  if (Array.isArray(content)) {
    const parts = [];
    for (const b of content) {
      if (b && b.type === 'text' && typeof b.text === 'string' && b.text.trim() !== '') {
        parts.push(b.text);
      }
    }
    return parts.join('\n');
  }
  return '';
}

/**
 * Derive the conversation name from a transcript's complete lines (PURE —
 * unit-testable). Tiered, matching the pinned proposal:
 *   tier 0 (opportunistic) — the NEWEST {"type":"summary"} line's `summary`
 *            (last occurrence wins; documented as effectively never present, so a
 *            cheap `"summary"` pre-filter keeps it nearly free).
 *   tier 1 (PRIMARY) — the FIRST real user prompt (skip isNonPromptUserLine),
 *            reading content by actual shape; an empty extraction → keep scanning.
 *   tier 2 — null (caller falls back to tmuxTitle).
 * Returns a sanitized, codepoint-capped single-line string, or null.
 */
function deriveConversationName(lines) {
  if (!Array.isArray(lines)) return null;
  // Tier 0 — newest summary.
  let summary = null;
  for (const raw of lines) {
    if (!raw || raw.indexOf('"summary"') < 0) continue; // cheap pre-filter
    let o;
    try { o = JSON.parse(raw); } catch (e) { continue; }
    if (o && o.type === 'summary' && typeof o.summary === 'string') {
      const f = finalizeName(o.summary);
      if (f) summary = f; // keep updating so the LAST (newest) summary wins
    }
  }
  if (summary) return summary;
  // Tier 1 — first real user prompt.
  for (const raw of lines) {
    if (!raw) continue;
    let o;
    try { o = JSON.parse(raw); } catch (e) { continue; }
    if (!o || o.type !== 'user') continue;
    if (isNonPromptUserLine(o)) continue;
    const content = o.message ? o.message.content : undefined;
    const f = finalizeName(extractUserText(content));
    if (!f) continue; // empty after sanitize → try the next prompt
    return f;
  }
  // Tier 2.
  return null;
}

/**
 * Derive the binary working/idle signal from a transcript's complete lines
 * (PURE — unit-testable, UC-48). Reuses the scanPending tail classifier so the
 * list-row signal matches the AC18 switcher badging semantics:
 *   "working" = there is ≥1 transcript entry AND the last meaningful entry is
 *   NOT a {type:"system",subtype:"turn_duration"} turn-end (a turn is
 *   mid-flight). A pending AskUserQuestion still awaiting its answer is treated
 *   as at-rest IDLE (matches the conversation view's classification of a pending
 *   question), so it returns false. THINKING/WORKING collapse to one binary.
 * Returns true when working, false when idle (incl. empty / no-input).
 */
function deriveWorking(lines) {
  if (!Array.isArray(lines) || lines.length === 0) return false;
  const tail = lines.slice(Math.max(0, lines.length - 60));
  let lastAsk = -1;
  let lastTurnEnd = -1;
  let lastLineIsTurnEnd = false;
  for (let i = 0; i < tail.length; i++) {
    let o;
    try { o = JSON.parse(tail[i]); } catch (e) { continue; }
    if (o && o.type === 'system' && o.subtype === 'turn_duration') {
      lastTurnEnd = i;
      lastLineIsTurnEnd = i === tail.length - 1;
    } else {
      lastLineIsTurnEnd = false;
    }
    if (o && o.type === 'assistant' && o.message && Array.isArray(o.message.content)) {
      for (const b of o.message.content) {
        if (b && b.type === 'tool_use' && b.name === 'AskUserQuestion') lastAsk = i;
      }
    }
  }
  // A pending question awaiting its answer is at-rest IDLE (conversation-view parity).
  if (lastAsk >= 0 && lastAsk > lastTurnEnd) return false;
  // Working when there is content and the last meaningful entry is not a turn-end.
  return tail.length > 0 && !lastLineIsTurnEnd;
}

// ──────────────────────── pending-question detection (UC-49) ────────────────────────

/**
 * UC-49 — visible-pane chrome of a LIVE, awaiting-answer AskUserQuestion sheet,
 * PINNED to the Claude Code TUI build in
 * {@code InputInjectionService.PINNED_CLAUDE_VERSION} (2.1.169). The transcript
 * tail CANNOT see a pending question — the UC-48 live finding proved Claude does
 * not persist the blocking assistant turn while it waits — so the only reliable
 * signal is the rendered screen, which is why {@link conversationName} scrapes
 * `tmux capture-pane`. A TUI restyle of the sheet is a ONE-LINE change here: bump
 * the pinned version and adjust the markers below.
 */
const PENDING_QUESTION_CHROME = {
  // Kept in lock-step with InputInjectionService.PINNED_CLAUDE_VERSION.
  pinnedClaudeVersion: '2.1.169',
  // Free-text / chat-instead affordance rows the AskUserQuestion sheet renders
  // (single AND multi-question): "Type something" is the free-text "Other" row
  // (always the last option); "Chat about this" sits outside the option ring.
  affordance: /Type something|Chat about this/,
  // The selected-option cursor glyph the sheet draws on the focused option.
  optionCursor: /❯/,
  // Multi-question wizard tab strip: a "Submit" review tab + checkbox glyphs
  // (`← ☐ Q1  ☐ Q2 … ✔ Submit →`).
  wizardSubmit: /Submit/,
  wizardCheckbox: /[☐☑✔✓]/,
  // ExitPlanMode (UC-40 delivers it live too) uses DIFFERENT chrome — a plan
  // approval prompt with no free-text affordance — and must NOT raise "?".
  excludeExitPlanMode: /ExitPlanMode|Ready to code\?|No, keep planning/i,
};

/**
 * UC-49 — PURE predicate (exported for QA): does the captured VISIBLE pane text
 * show a pending AskUserQuestion awaiting an answer? Single- and multi-question
 * agnostic (AC9). Requires CO-OCCURRING chrome — an affordance row PLUS the option
 * cursor, OR the affordance row PLUS the multi-question wizard tab strip — so an
 * ordinary line of prose that merely contains "Type something" never trips it.
 * {@code ExitPlanMode} is explicitly excluded. Returns false for empty/non-string
 * input. PURE: no I/O, deterministic on its argument.
 */
function looksLikePendingAskUserQuestion(paneText) {
  if (typeof paneText !== 'string' || paneText.length === 0) return false;
  const c = PENDING_QUESTION_CHROME;
  if (c.excludeExitPlanMode.test(paneText)) return false;
  const hasAffordance = c.affordance.test(paneText);
  const hasOptionCursor = c.optionCursor.test(paneText);
  const hasWizardTabs = c.wizardSubmit.test(paneText) && c.wizardCheckbox.test(paneText);
  // Single-question sheet: affordance row + the option cursor.
  // Multi-question wizard: affordance row + the Submit/checkbox tab strip.
  return hasAffordance && (hasOptionCursor || hasWizardTabs);
}

/**
 * UC-49 — capture the MAIN pane's VISIBLE screen ONLY (no `-S` scrollback, AC5)
 * via the SAME {@link targetSpec} the name/working signal already resolves, so
 * pending and working always describe the same pane. Returns the captured text,
 * or {@code null} on an exec failure / non-zero exit / an empty capture. {@code
 * null} is the "unknown" signal (failure policy (b)): {@link conversationName}
 * then omits the pending line so the server RETAINS its prior pending value for
 * this tick, avoiding a one-poll "?" flicker while a question is genuinely up.
 */
function capturePaneText() {
  try {
    const res = execFileSync(
      'tmux',
      tmuxArgs(['capture-pane', '-p', '-t', targetSpec()]),
      { encoding: 'utf8', timeout: 5000 },
    );
    const s = String(res);
    return s.length > 0 ? s : null;
  } catch (e) {
    return null;
  }
}

// ──────────────────────── pending-prompt parsing (UC-50) ────────────────────────

/**
 * UC-50 — visible-pane chrome of a LIVE, awaiting-answer {@code ExitPlanMode}
 * plan-approval prompt. {@link looksLikePendingAskUserQuestion} deliberately
 * EXCLUDES this prompt (it is different chrome — a plan approval, no free-text
 * affordance); this predicate is its dedicated counterpart so the plan prompt is
 * delivered live too (AC6). PINNED to {@link PENDING_QUESTION_CHROME.pinnedClaudeVersion}.
 */
const PLAN_APPROVAL_CHROME = {
  pinnedClaudeVersion: '2.1.169',
  // The plan-mode "proceed?" prompt markers. "keep planning" is the highly
  // specific Reject option label; "Ready to code?"/"Would you like to proceed?"
  // are the prompt headers across builds.
  marker: /Would you like to proceed\?|keep planning|Ready to code\?/i,
  // The selected-option cursor glyph — required so a mere mention of "keep
  // planning" in prose never trips it.
  optionCursor: /❯/,
};

/**
 * UC-50 — PURE predicate (exported for QA): does the captured VISIBLE pane show a
 * pending {@code ExitPlanMode} plan-approval awaiting an answer? Requires the plan
 * marker AND the option cursor. Returns false for empty/non-string input.
 */
function looksLikePendingPlanApproval(paneText) {
  if (typeof paneText !== 'string' || paneText.length === 0) return false;
  const c = PLAN_APPROVAL_CHROME;
  return c.marker.test(paneText) && c.optionCursor.test(paneText);
}

// Volatile pane lines (spinner / status bar / nav hints) stripped before hashing
// a prompt into its stable key, so the key is identical across polls while the
// session is blocked and changes ONLY when the actual prompt changes. This is
// what makes the settle (require the key stable across one extra poll) converge.
const PANE_VOLATILE_LINE =
  /Brewed|esc to interrupt|bypass permissions|control this session|\/remote-control|↑↓|↑\/↓|Tab\/Arrow|to navigate|Enter to select|Esc to cancel|tokens/i;

/** Drop volatile/blank lines and trailing whitespace; join. (PURE) */
function stripVolatile(paneText) {
  return String(paneText)
    .split('\n')
    .filter((l) => l.trim() !== '' && !PANE_VOLATILE_LINE.test(l))
    .map((l) => l.replace(/\s+$/g, ''))
    .join('\n');
}

/** FNV-1a 32-bit hash → short hex (no Date/Math.random; resume-safe). (PURE) */
function fnv1a(s) {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString(16);
}

// Affordance rows that are NOT real options ("Other" free-text / chat escape) —
// always excluded from the parsed option list and the option count.
const AFFORDANCE_OPTION = /^(type something\.?|chat about this\.?)$/i;

/**
 * UC-50 — parse the multi-question WIZARD tab-strip headers (PURE). The wizard strip
 * carries a "Submit" review tab (`←  ☐ Color  ☐ Size  ✔ Submit  →`); we collect each
 * label following a box glyph and drop the "Submit" tab. The strip is identified by
 * the box glyphs {@code ☐☑✔✓} (NOT ASCII `[ ]`/`[x]` option markers) AND the presence
 * of "Submit", and a numbered option row is never mistaken for it. Returns [] when no
 * Submit-bearing wizard strip is present — i.e. for a single-SELECT single question
 * (whose lone ` ☐ Header` tab has no Submit). Its sole job is the multi-QUESTION
 * decision in {@link parsePendingPrompt}: {@code length > 1} ⇒ a multi-question batch
 * (answerable=false; only the focused tab's options are on screen). A single
 * question's header is recovered separately via {@link parseSingleTabHeader}.
 */
function parseWizardHeaders(paneText) {
  const lines = String(paneText).split('\n');
  for (const l of lines) {
    if (!/Submit/.test(l) || !/[☐☑✔✓]/.test(l)) continue;
    if (/^\s*❯?\s*\d+\.\s/.test(l)) continue; // a numbered option row, not the tab strip
    const headers = [];
    const re = /[☐☑✔✓]\s*([^☐☑✔✓→←]+)/g;
    let m;
    while ((m = re.exec(l)) !== null) {
      const label = m[1].trim();
      if (label && !/^submit$/i.test(label)) headers.push(label);
    }
    if (headers.length > 0) return headers;
  }
  return [];
}

/**
 * UC-50 — recover a SINGLE question's header from its tab line (PURE). claude renders
 * a tab strip even for a single question — a lone ` ☐ Database` (single-select, no
 * Submit) or `←  ☐ Toppings  ✔ Submit  →` (multi-select). This returns the first
 * non-Submit box-glyph label (the question's header), tolerating the absence of
 * "Submit"/arrows that {@link parseWizardHeaders} requires. A numbered option row is
 * never matched. Returns '' when there is no tab line (e.g. a bare prompt). Used only
 * by the single-question branch of {@link parsePendingPrompt} (BUG-1b — AC3 header).
 */
function parseSingleTabHeader(paneText) {
  const lines = String(paneText).split('\n');
  for (const l of lines) {
    if (!/[☐☑✔✓]/.test(l)) continue;
    if (/^\s*❯?\s*\d+\.\s/.test(l)) continue; // a numbered option row, not the tab strip
    const m = /[☐☑✔✓]\s*([^☐☑✔✓→←]+)/.exec(l);
    if (m) {
      const label = m[1].trim();
      if (label && !/^submit$/i.test(label)) return label;
    }
  }
  return '';
}

/**
 * UC-50 — parse the numbered option rows of the FOCUSED question (PURE). Each
 * `❯? N. <label>` row, with the following indented non-numbered line taken as its
 * description. A leading multi-select marker ({@code [ ]}/{@code [x]}/{@code ☐}/
 * {@code ☑}) is stripped from the label BEFORE the affordance test and before
 * storing, so "[ ] Cheese" stores as "Cheese" and "[ ] Type something" is still
 * recognised as the affordance row. Affordance rows ("Type something." / "Chat
 * about this") are dropped, so the option count is the count of REAL options only.
 */
function parseNumberedOptions(paneText) {
  const lines = String(paneText).split('\n');
  const opts = [];
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(/^\s*❯?\s*(\d+)\.\s+(.*\S)\s*$/);
    if (!m) continue;
    const label = m[2].trim().replace(/^(\[[ xX]?\]|[☐☑])\s*/, '').trim();
    if (AFFORDANCE_OPTION.test(label)) continue;
    let description = '';
    for (let j = i + 1; j < lines.length; j++) {
      const t = lines[j].trim();
      if (t === '') break;
      if (/^\s*❯?\s*\d+\.\s+/.test(lines[j])) break;
      if (/^[─—-]{3,}$/.test(t)) break;
      description = t;
      break;
    }
    opts.push({ label, description });
  }
  return opts;
}

/**
 * UC-50 — does the FOCUSED question's option list carry per-option checkbox markers
 * ({@code [ ]}/{@code [x]} or {@code ☐}/{@code ☑}) — i.e. is it a multi-SELECT
 * question (PURE)? Decided from the numbered OPTION rows ONLY, never from the tab
 * strip (whose `☐` boxes are per-question answered-state, not per-option select).
 * This is the correct multiSelect signal: a single-select question's numbered rows
 * have no bracket/box marker, a multi-select question's rows do.
 */
function optionsHaveCheckbox(paneText) {
  const lines = String(paneText).split('\n');
  for (const l of lines) {
    const m = l.match(/^\s*❯?\s*\d+\.\s+(.*)$/);
    if (!m) continue;
    if (/^(\[[ xX]?\]|[☐☑])/.test(m[1].trim())) return true;
  }
  return false;
}

/**
 * UC-50 — the focused question's prompt text: the nearest non-blank, non-chrome
 * line above the first numbered option row (PURE). Skips separators, tool/output
 * markers (●/✻), and the tab strip / checkbox lines. Returns '' when no option row
 * is found.
 */
function parseFocusedPrompt(paneText) {
  const lines = String(paneText).split('\n');
  let firstOpt = -1;
  for (let i = 0; i < lines.length; i++) {
    if (/^\s*❯?\s*\d+\.\s+/.test(lines[i])) {
      firstOpt = i;
      break;
    }
  }
  if (firstOpt < 0) return '';
  for (let i = firstOpt - 1; i >= 0; i--) {
    const t = lines[i].trim();
    if (t === '') continue;
    if (/^[─—-]{3,}$/.test(t)) continue; // separator rule
    if (/^[●✻]/.test(t)) return ''; // a tool/output marker, not a prompt
    if (/Submit/.test(t) && /[☐☑✔✓]/.test(t)) continue; // wizard tab strip (multi-tab)
    if (/^[☐☑✔✓←→]/.test(t)) continue; // a single-tab strip / checkbox line (` ☐ Header`)
    return t.replace(/^❯\s*/, '').trim();
  }
  return '';
}

/**
 * UC-50 — PURE: parse the structured pending prompt from a captured VISIBLE pane.
 * Returns {@code {kind:'questions'|'plan', questions:[{header,question,multiSelect,
 * options:[{label,description}]}], plan, key}} or null when the pane shows no
 * pending prompt. The {@code key} is a hash of the volatile-stripped pane, so it is
 * stable across polls while blocked and changes when the prompt changes (drives the
 * settle + once-per-prompt emission). Single questions are recovered FULLY; a
 * multi-question wizard is recovered as header-only items (only the focused tab's
 * options are on screen), and the server marks those answerable=false.
 */
function parsePendingPrompt(paneText) {
  if (typeof paneText !== 'string' || paneText.length === 0) return null;
  const key = 'pane-' + fnv1a(stripVolatile(paneText));
  if (looksLikePendingPlanApproval(paneText)) {
    return { kind: 'plan', questions: [], plan: '', key };
  }
  if (!looksLikePendingAskUserQuestion(paneText)) return null;
  const headers = parseWizardHeaders(paneText);
  if (headers.length > 1) {
    // MULTI-question wizard — header-only items (the other tabs' options are not
    // captured). Server decides answerable=false from questions.length>1 (AC2 gate).
    const questions = headers.map((h) => ({ header: h, question: '', multiSelect: false, options: [] }));
    return { kind: 'questions', questions, plan: '', key };
  }
  // SINGLE question (one tab or none) — full structured recovery from one capture
  // (AC3). multiSelect is decided from the OPTION rows' checkbox markers, NOT from
  // the tab strip's `☐` (which is per-question answered-state); the single tab's
  // label, when present, is this question's header.
  const options = parseNumberedOptions(paneText);
  const multiSelect = optionsHaveCheckbox(paneText);
  const question = parseFocusedPrompt(paneText);
  const header = headers[0] || parseSingleTabHeader(paneText);
  return {
    kind: 'questions',
    questions: [{ header, question, multiSelect, options }],
    plan: '',
    key,
  };
}

/**
 * UC-55 — PURE: parse the CURRENTLY-FOCUSED wizard tab's real content from one
 * captured VISIBLE pane. Unlike {@link parsePendingPrompt} (which short-circuits a
 * multi-question wizard to header-only items because a single capture only shows the
 * focused tab), this is the per-tab entrypoint the server calls after stepping the
 * live pane to a given tab — so it MUST recover that tab's full options. Returns
 * {@code {question, multiSelect, options:[{label,description}]}}. The {@code header}
 * is NOT returned here: the server owns the tab order (it drove the stepping) and
 * pairs each parse with the header it already has, since {@link parseSingleTabHeader}
 * cannot identify WHICH tab is focused from plain text (it always returns the first
 * tab's label). Returns null only for empty/non-string input.
 */
function parseFocusedTab(paneText) {
  if (typeof paneText !== 'string' || paneText.length === 0) return null;
  return {
    question: parseFocusedPrompt(paneText),
    multiSelect: optionsHaveCheckbox(paneText),
    options: parseNumberedOptions(paneText),
  };
}

/**
 * UC-55 — one-shot {@code --parse-pane} mode: capture the focused pane (READ-ONLY —
 * no keystroke; the server owns stepping) and print the focused tab's parsed content
 * as a single JSON line, exit 0. On a capture failure or no visible AskUserQuestion
 * chrome, print {@code {}} so the server treats this tab as unrecovered (it will
 * fall back to leaving that tab header-only / answerable=false rather than guessing).
 */
function parsePaneOnce() {
  const paneText = capturePaneText();
  if (paneText == null || !looksLikePendingAskUserQuestion(paneText)) {
    out('{}');
    return;
  }
  const parsed = parseFocusedTab(paneText);
  out(JSON.stringify(parsed || {}));
}

/**
 * UC-69 — PURE: the notification BODY text for a pending AskUserQuestion — the
 * FIRST question's prompt (AC3: when several questions are raised together, the
 * first one). Takes the parsed prompt from {@link parsePendingPrompt}; prefers the
 * focused question's prompt text, falling back to its header when the prompt line
 * was not recovered (a multi-question wizard yields header-only items). Sanitised
 * to a single line and codepoint-capped. Returns '' when there is no usable text,
 * so {@link conversationName} OMITS line 4 and the server RETAINS its prior text
 * (failure policy (b)) rather than clobbering a good body with an empty one.
 */
function firstQuestionText(parsed) {
  if (
    !parsed ||
    parsed.kind !== 'questions' ||
    !Array.isArray(parsed.questions) ||
    parsed.questions.length === 0
  ) {
    return '';
  }
  const q = parsed.questions[0] || {};
  const raw = q.question || q.header || '';
  return capCodepoints(sanitizeOneLine(raw), CONVERSATION_NAME_MAX_CP);
}

/**
 * One-shot: resolve the MAIN pane's active transcript, derive the conversation
 * name AND the working/idle signal from the SAME readAllLines, and print up to
 * FOUR lines, exit 0 (UC-47 line1 + UC-48 line2 + UC-49 line3 + UC-69 line4):
 *   line1 = the conversation name, or empty when none (server parses it via
 *           firstLine — unchanged from UC-47).
 *   line2 = "working" | "idle" (server parses it via secondLine).
 *   line3 = "pending-question" | "none" (UC-49; server parses it via thirdLine).
 *           APPEND-ONLY and back-compat: an old server ignores it, and it is
 *           OMITTED entirely (2-line output, exactly the pre-UC-49 shape) when the
 *           pane capture fails, so the server retains its prior pending value
 *           (failure policy (b)) rather than flickering the "?" off.
 *   line4 = the first pending question's text (UC-69; server parses it via
 *           fourthLine). APPEND-ONLY and back-compat: only emitted when line3 is
 *           "pending-question" AND a non-empty body was parsed from the SAME
 *           capture (no second capture). OMITTED on a capture/parse miss, so the
 *           server RETAINS its prior text rather than clobbering it (failure
 *           policy (b)); an old (pre-UC-69) server simply ignores the extra line.
 * Any no-transcript / failure path prints empty name + idle so the server falls
 * back to tmuxTitle (AC3) and shows no spinner. Never blocks.
 */
function conversationName() {
  const ctx = resolveMainContextOnce();
  const mainPath = ctx.mainPath;
  if (!mainPath) { out(''); out('idle'); return; }
  const lines = readAllLines(mainPath);
  const name = deriveConversationName(lines);
  // UC-49 — compute pending FIRST from the VISIBLE pane (the transcript can't see a
  // blocking AskUserQuestion). null ⇒ capture failed → omit line3 so the server
  // RETAINS its prior pending value (failure policy (b)); the resulting 2-line
  // output matches the pre-UC-49 shape exactly.
  const paneText = capturePaneText();
  const pending = paneText == null ? null : looksLikePendingAskUserQuestion(paneText);
  out(name || '');
  // Revised working (AC5, source-level mutual exclusion): a pending question is
  // at-rest "waiting", never "working" — pending ⇒ idle (absolute top precedence,
  // preserving the UC-48 pending-question gap and UC-49 "?" even when a delegate is
  // mid-turn — AC3/AC6). Otherwise the lead's own transcript-derived working signal
  // OR, when the lead has delegated and gone idle, any team-agent / background
  // subagent that is still working (UC-59, AC1/AC2/AC4). deriveWorking(lines) is
  // evaluated first so the common lead-is-working case short-circuits before the
  // (heavier) /proc + delegate-transcript scan. The server enforces the same
  // pending-precedence too.
  const mainStem = path.basename(mainPath, '.jsonl');
  const working = pending === true
    ? false
    : (deriveWorking(lines) || anyDelegateWorking(mainPath, mainStem, ctx.slug, ctx.claudePid));
  out(working ? 'working' : 'idle');
  if (pending !== null) {
    out(pending ? 'pending-question' : 'none');
    // UC-69 — line 4 (APPEND-ONLY): when a question is up, emit the first
    // question's text as the notification body, parsed from the SAME already-
    // captured pane (no second capture). Omitted when no body parses, so the
    // server retains its prior text (tri-state, mirroring the line-3 policy).
    if (pending === true) {
      const body = firstQuestionText(parsePendingPrompt(paneText));
      if (body) out(body);
    }
  }
}

// ──────────────────────── list-subagents (one-shot, UC-60) ────────────────────────

/**
 * UC-60 — one-shot {@code --list-subagents} mode: resolve the MAIN pane's transcript,
 * enumerate its {@code subagents/agent-*.jsonl}, and print one JSON object per LIVE
 * subagent ({@code {id,label,working}}). A no-transcript / no-subagents state prints
 * nothing (exit 0) so the server simply appends no subagent pills. Never blocks.
 */
function listSubagents(nowMs) {
  if (nowMs === undefined) nowMs = Date.now();
  const mainPath = resolveTranscriptOnce();
  if (!mainPath) return;
  for (const sf of listSubagentFiles(mainPath)) {
    const st = statSafe(sf);
    if (!st) continue;
    if (nowMs - st.mtimeMs > SUBAGENT_STALE_MS) continue; // aged out → finished/crashed
    const id = subagentId(sf);
    const working = deriveWorking(readBoundedTailLines(sf, TAIL_SCAN_BYTES));
    const label = subagentLabel(sf, id);
    out(JSON.stringify({ id, label, working }));
  }
}

// ──────────────────────── streaming mode ────────────────────────

function backfill(reader, n, nowMs, emitStartCtrl) {
  if (nowMs === undefined) nowMs = Date.now();
  let buf;
  try {
    buf = fs.readFileSync(reader.filePath);
  } catch (e) {
    // UC-79 — the PRIMARY reader still owes the server a backfill-start cursor seed
    // even when its file does not exist yet (start at 0): otherwise the server's
    // oldest-line cursor would never be seeded and a load-older could never page.
    if (emitStartCtrl) out('__ctrl__\t' + CTRL_BACKFILL_START + '\t0');
    return;
  }
  // Split at the last newline so a trailing PARTIAL line is preserved in the
  // residual (and continued by readNewLines) rather than skipped — otherwise
  // advancing the offset past a half-written line would corrupt it on completion.
  const lastNl = buf.lastIndexOf(0x0a);
  const completeEnd = lastNl >= 0 ? lastNl + 1 : 0;
  const completeStr = buf.toString('utf8', 0, completeEnd);
  let lines = completeStr.split('\n');
  if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();
  lines = lines.filter((l) => l.length > 0);
  const start = Math.max(0, lines.length - n);
  // UC-79 — the primary reader carries its window's start line index on the
  // backfill-start control so the server seeds its oldest-line cursor from it. The
  // index space matches readAllLines (non-empty complete lines), so a later
  // --fetch-page --before-line <start> reads contiguously older lines (AC2/AC6).
  if (emitStartCtrl) out('__ctrl__\t' + CTRL_BACKFILL_START + '\t' + start);
  for (let i = start; i < lines.length; i++) {
    out(reader.source + '\t' + lines[i]);
  }
  // Capture the trailing partial line in the residual. Set offset to buf.length
  // (NOT completeEnd): those bytes are already in `residual`, so advancing only to
  // completeEnd would make the next readNewLines re-read [completeEnd, size) and
  // DUPLICATE the trailing partial (UC-40 Bug 2 — corrupts a connect-time pending
  // question). For a newline-terminated file completeEnd === buf.length, so this
  // is a no-op on the common path.
  reader.residual = buf.toString('utf8', completeEnd, buf.length);
  reader.offset = buf.length;
  // Seed the idle-flush bookkeeping: a connect-time stranded question sits in the
  // residual here and must become eligible for live delivery after the idle. Use
  // a numeric stamp only when residual is non-empty; an empty residual leaves the
  // timer null (nothing to flush).
  reader.residualSinceMs = reader.residual ? nowMs : null;
  reader.pendingFlushed = null;
  const st = statSafe(reader.filePath);
  reader.ino = st ? st.ino : null;
}

async function streamLoop() {
  let anchorClaudePid = null; // the claude PID the current anchor was resolved from
  let mainPath = null;
  let mainReader = null;
  const subReaders = new Map(); // filePath → reader
  let graceStart = null;
  let noTranscriptEmitted = false;
  // UC-50 — pane-signal pending-prompt state. `emittedPendingKey` is the prompt
  // key currently delivered as pending (null when none / cleared); `candidateKey`
  // is a key seen once but not yet confirmed (the settle: require it stable across
  // one extra poll before emitting, so a half-drawn frame never delivers).
  let emittedPendingKey = null;
  let candidatePendingKey = null;

  function rebaseline(newMain, announce) {
    if (announce) emitCtrl(CTRL_REBASELINE);
    mainPath = newMain;
    mainReader = makeReader(mainPath, 'main');
    subReaders.clear();
    // UC-79 — the PRIMARY (main) reader emits backfill-start itself, carrying its
    // window start index so the server seeds its oldest-line cursor (AC2). Subagent
    // backfills follow inside the same window and carry no cursor of their own.
    backfill(mainReader, ARGS.backfill, undefined, true);
    for (const sf of listSubagentFiles(mainPath)) {
      const r = makeReader(sf, subagentSource(sf));
      backfill(r, ARGS.backfill);
      subReaders.set(sf, r);
    }
    emitCtrl(CTRL_BACKFILL_END);
    graceStart = null;
    noTranscriptEmitted = false;
  }

  // Live poll loop. Resolution re-runs when the pane's claude PID changes
  // (entrypoint restart loop → fresh claude → new transcript) OR when a same-PID
  // transcript ROTATION is detected (UC-65: `/clear` starts a new session jsonl
  // in-process). Otherwise the anchored file is followed stably, so the tail never
  // hops onto a concurrent teammate or foreign-session transcript in the shared
  // slug dir.
  // eslint-disable-next-line no-constant-condition
  while (true) {
    const panePid = resolvePanePid();
    const claudePid = findClaudePid(panePid, 3);

    if (claudePid != null && (claudePid !== anchorClaudePid || mainPath == null)) {
      const resolved = resolveTranscriptForClaude(claudePid);
      if (resolved) {
        const hadAnchor = mainPath != null;
        anchorClaudePid = claudePid;
        rebaseline(resolved, hadAnchor && resolved !== mainPath);
      }
    } else if (claudePid != null && mainPath != null) {
      // UC-65 — same claude PID, but `/clear` (or any in-process new-session
      // rotation) may have started a fresh transcript the PID-change guard above
      // can't see. Follow it: rebaseline so the wiped/empty transcript renders and
      // post-clear turns stream again (AC5/AC8). `announce` → the client (under its
      // post-clear suppression guard) re-wipes on the backfill-start that follows.
      const rotated = detectRotation(claudePid, mainPath);
      if (rotated && rotated !== mainPath) {
        anchorClaudePid = claudePid;
        rebaseline(rotated, true);
      }
    }

    if (mainPath == null) {
      // Resolution has not yet produced a file — fail LOUD after a bounded grace
      // instead of hanging silently (the original bug class).
      if (graceStart == null) {
        graceStart = Date.now();
      } else if (!noTranscriptEmitted && Date.now() - graceStart >= GRACE_MS) {
        emitCtrl(CTRL_NO_TRANSCRIPT);
        noTranscriptEmitted = true;
      }
      await sleep(POLL_MS);
      continue;
    }

    if (mainReader) {
      for (const line of readNewLines(mainReader)) {
        out(mainReader.source + '\t' + line);
      }
      // Idle/safety-net flush (UC-40): deliver the stranded, complete trailing line
      // live while `claude` is still blocked on an AskUserQuestion / ExitPlanMode
      // answer. idleFlush never touches offset/residual; the eventual
      // newline-terminated copy is suppressed once by readNewLines.
      const fl = idleFlush(mainReader, Date.now());
      if (fl) out(mainReader.source + '\t' + fl);
    }

    // Re-glob subagent files; new ones get a bounded backfill, known ones append.
    for (const sf of listSubagentFiles(mainPath)) {
      let r = subReaders.get(sf);
      if (!r) {
        r = makeReader(sf, subagentSource(sf));
        backfill(r, ARGS.backfill);
        subReaders.set(sf, r);
      } else {
        for (const line of readNewLines(r)) {
          out(r.source + '\t' + line);
        }
      }
    }

    // Idle/safety-net flush for every subagent (isSidechain) reader — a teammate's
    // blocking question must be delivered live too, not just the main transcript's.
    for (const r of subReaders.values()) {
      const fl = idleFlush(r, Date.now());
      if (fl) out(r.source + '\t' + fl);
    }

    // UC-50 — pane-signal pending-prompt detection. The transcript CANNOT see a
    // blocking AskUserQuestion / ExitPlanMode on claude 2.1.169 (the assistant turn
    // is buffered in memory until the answer, never written), so the residual
    // idle-flush above has nothing to flush. The reliable signal is the rendered
    // pane (the same class of signal UC-49 proved for the sessions-list "?"). We
    // capture the SAME targetSpec() pane the tail follows (so subagent panes are
    // covered too, AC8), gate on the pending predicates, and deliver via control
    // frames — NOT inline transcript lines, so the later transcript write (on a
    // residual-writing build) still owns the single inline bubble (dedupe correct).
    {
      const paneText = capturePaneText();
      // null ⇒ capture failed → retain prior state (no flicker), like UC-49 policy (b).
      if (paneText != null) {
        const pending = looksLikePendingAskUserQuestion(paneText) || looksLikePendingPlanApproval(paneText);
        if (!pending) {
          candidatePendingKey = null;
          if (emittedPendingKey != null) {
            out('__ctrl__\t' + CTRL_PENDING_CLEAR + '\t' + emittedPendingKey);
            emittedPendingKey = null;
          }
        } else {
          const parsed = parsePendingPrompt(paneText);
          if (parsed && parsed.key) {
            if (parsed.key === emittedPendingKey) {
              // already delivered this exact prompt — once-per-key guard.
            } else if (parsed.key === candidatePendingKey) {
              // Settled (stable across one extra poll) — deliver once.
              out(
                '__ctrl__\t' +
                  CTRL_PENDING_QUESTION +
                  '\t' +
                  JSON.stringify({
                    kind: parsed.kind,
                    questions: parsed.questions,
                    plan: parsed.plan,
                    key: parsed.key,
                  }),
              );
              emittedPendingKey = parsed.key;
              candidatePendingKey = null;
            } else {
              // First sighting of a new key — require one more matching poll (settle).
              candidatePendingKey = parsed.key;
            }
          }
        }
      }
    }

    await sleep(POLL_MS);
  }
}

/**
 * UC-60 — streaming tail of ONE subagent's transcript (the {@code --subagent <id>}
 * mode). Unlike {@link streamLoop} (which follows a tmux pane's claude transcript and
 * re-globs subagent files), this follows exactly one
 * {@code <mainStem>/subagents/agent-<id>.jsonl} and emits only {@code subagent:<id>}
 * lines — so tapping a subagent pill views THAT subagent's transcript and nothing
 * else (AC3). The subagent dir is derived from the MAIN pane's resolved transcript, so
 * a main rebaseline (entrypoint restart / `/clear` rotation) re-anchors the subagent
 * file under the new main stem. The file may not exist yet when a freshly-spawned
 * subagent is selected; we fail LOUD with {@code no-transcript} only after the same
 * bounded grace the main loop uses, then keep polling so it streams once it appears.
 */
async function streamSubagentLoop(id) {
  const source = 'subagent:' + id;
  let mainPath = null;
  let reader = null;
  let graceStart = null;
  let noTranscriptEmitted = false;

  while (true) {
    const resolvedMain = resolveTranscriptOnce();
    if (resolvedMain && resolvedMain !== mainPath) {
      // (Re)anchor the subagent file under the current main stem and backfill it.
      mainPath = resolvedMain;
      const sf = path.join(subagentDir(mainPath), 'agent-' + id + '.jsonl');
      reader = makeReader(sf, source);
      // UC-79 — in subagent-stream mode the subagent file IS the primary, so its
      // backfill emits the cursor-seeding backfill-start (start=0 when absent).
      if (statSafe(sf)) backfill(reader, ARGS.backfill, undefined, true);
      else out('__ctrl__\t' + CTRL_BACKFILL_START + '\t0');
      emitCtrl(CTRL_BACKFILL_END);
      graceStart = null;
      noTranscriptEmitted = false;
    }

    // Fail LOUD if we never resolve a main transcript OR the subagent file never
    // appears within the grace — instead of hanging silently (the UC-37 bug class).
    const haveFile = reader != null && statSafe(reader.filePath) != null;
    if (!haveFile) {
      if (graceStart == null) {
        graceStart = Date.now();
      } else if (!noTranscriptEmitted && Date.now() - graceStart >= GRACE_MS) {
        emitCtrl(CTRL_NO_TRANSCRIPT);
        noTranscriptEmitted = true;
      }
      await sleep(POLL_MS);
      continue;
    }

    for (const line of readNewLines(reader)) {
      out(source + '\t' + line);
    }
    // Idle/safety-net flush (UC-40) — a subagent that wrote a complete trailing line
    // with no newline (rare for a background subagent, but symmetric with the main
    // tail) is still delivered live.
    const fl = idleFlush(reader, Date.now());
    if (fl) out(source + '\t' + fl);

    await sleep(POLL_MS);
  }
}

function sleep(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

// ──────────────────────── main ────────────────────────

if (require.main === module) {
  if (ARGS.scanPending) {
    try {
      scanPending();
    } catch (e) {
      out('idle');
    }
    process.exit(0);
  } else if (ARGS.fetchDetail) {
    try {
      fetchDetail();
    } catch (e) {
      emitCtrl(CTRL_DETAIL_NOT_FOUND);
    }
    process.exit(0);
  } else if (ARGS.fetchPage) {
    try {
      fetchPage();
    } catch (e) {
      // UC-79 — any failure degrades to "no older lines, at start" so the client
      // simply stops paging (never a hang); mirrors --fetch-detail's graceful miss.
      out('__ctrl__\t' + CTRL_PAGE_META + '\t' + (ARGS.beforeLine == null ? 0 : ARGS.beforeLine) + '\t1');
    }
    process.exit(0);
  } else if (ARGS.conversationName) {
    try {
      conversationName();
    } catch (e) {
      // Any failure → empty (no name); the server falls back to tmuxTitle (AC3).
      out('');
    }
    process.exit(0);
  } else if (ARGS.parsePane) {
    try {
      parsePaneOnce();
    } catch (e) {
      // Any failure → empty object; the server treats this tab as unrecovered (UC-55).
      out('{}');
    }
    process.exit(0);
  } else if (ARGS.listSubagents) {
    try {
      listSubagents();
    } catch (e) {
      // Any failure → print nothing; the server appends no subagent pills (UC-60).
    }
    process.exit(0);
  } else if (ARGS.subagentId) {
    // UC-60 — stream ONE subagent's transcript (tapping a subagent pill).
    streamSubagentLoop(ARGS.subagentId).catch((e) => {
      process.exit(0);
    });
  } else {
    streamLoop().catch((e) => {
      // Never crash the session on an internal error — exit quietly so the server
      // sees EOF and can re-spawn / surface a tail_failed if appropriate.
      process.exit(0);
    });
  }
}

