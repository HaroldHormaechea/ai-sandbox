workspace/*
!workspace/.gitkeep

claude-config/*
!claude-config/.gitkeep

secrets/*
!secrets/.gitkeep

# UC06 — Claude pre-init template captured by `aisandboxctl secrets seed`.
# In developer-mode docker-compose runs this defaults to an in-repo dir;
# we ship the empty dir (via .gitkeep) so the bind-mount target exists,
# but the captured contents must never get committed.
templates/claude-config/*
!templates/claude-config/.gitkeep

# Monotonic session counter (UC02 — multi-session containers).
.ai-sandbox-counter
.ai-sandbox-counter.lock/

# UC22 — operator's optional-toolchain selection (drives `docker compose build`
# build args). Machine-local; never committed.
.ai-sandbox-toolchains

# UC26 — operator's "Select the development tools you want to install" choices
# (e.g. `dind` for Docker-in-Docker). Machine-local; never committed. Read by
# spawn.sh / spawn.ps1 to inject spawn-time env vars + compose override files.
.ai-sandbox-devtools

# Persisted, per-machine dev workspace root. As of the workspace-relocation
# change the dev-mode workspace lives OUTSIDE this repo by default (under
# $XDG_STATE_HOME/ai-sandbox or %LOCALAPPDATA%\ai-sandbox); spawn.sh / clean.sh
# read the frozen absolute path from this file so they always agree. The
# in-repo `workspace/`/`workspace-*/` entries below are kept for backward compat
# (an operator may deliberately opt back in with AI_SANDBOX_DEV_WORKSPACE_ROOT=.).
.ai-sandbox-workspace-root

# Per-session isolated host directories created by ./spawn.sh.
workspace-*/
claude-config-*/

# UC03 — Java/Gradle server build artefacts.
.gradle/
build/
server/build/
server/bin/
server/.gradle/
*.class

# Machine-specific Android SDK location (written by local dev setup; never commit).
local.properties
